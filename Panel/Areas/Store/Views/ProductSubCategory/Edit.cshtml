@using DataLayer.Base;
@using DataLayer.Entities;
@using DataLayer.Enumarables;
@model DataLayer.Entities.ProductSubCategory

@{
    ViewBag.Title = Resource.Lang.EditSubordinateProduct;
    Layout = "~/Views/Shared/Layout.cshtml";
}
<input id="LastPictureId" type="hidden" value="@Model.PictureId" />
<input id="LastIconId" type="hidden" value="@Model.IconId" />
<div codeprocess-ajax-form="/store/productsubcategory/edit" codeprocess-back-form="/store/productsubcategory?categoryId=@Model.CategoryId">
    @Html.HiddenFor(model => model.ID)
    @Html.HiddenFor(model => model.SyncId)
    @Html.HiddenFor(model => model.SyncDatetime)
    @Html.HiddenFor(model => model.UpdateDatetime)
    <div class="col-sm-12">
        <div class="card-box">
            <a href="@Url.Action("index")" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title="بازگشت"></a>
            <div class="col-sm-12">
                <div class="form-horizontal">
                    <div class="col-sm-6 no-padding">
                        <fieldset>
                            <legend>@Resource.Lang.ProductSubCategory</legend>
                            <div class="form-group">
                                @Html.LabelFor(model => model.CategoryId, Resource.Lang.Category, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownList("CategoryId", null, htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Name, Resource.Lang.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Description, Resource.Lang.Summery, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.MinDescription, "خلاصه محتوا", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.MinDescription, new { @class = "form-control", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Body, "محتوا", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Body, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @codeprocess = "editor" } })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.LandingText, "لندینگ", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.LandingText, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @autofocus = "autofocus", @codeprocess = "editor" } })
                                </div>
                            </div>
                            @if (BaseWebsite.WebsiteSetting.HasActive)
                            {

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Active, "وضعیت نمایش", htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.Active)
                                    </div>
                                </div>
                            }

                            <div class="form-group">
                                @Html.LabelFor(model => model.Priority, Resource.Lang.DisplayPriority, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Priority, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                    @Html.ValidationMessageFor(model => model.Priority, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="font-bold">
                                    اولویت های ثبت شده
                                </div>
                                <div class="col-lg-12">
                                    <div id="divprority"></div>
                                    @*@Html.Partial("~/Areas/store/Views/ProductCategory/PriorityList.cshtml")*@
                                    @*@Html.Action("PriorityList", "ProductCategory", new { categoryId = Model.CategoryId })*@
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">افزودن تگ</label>
                                <div class="col-md-10">
                                    <div id="divTag" class="d-flex">
                                        <input type="text" id="tagText" class="form-control text-box single-line">
                                        <button onclick="SubmitTage(@Model.ID)" class="btn btn-success">ثبت</button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="font-bold">
                                    لیست تگ ها
                                </div>
                                <div class="col-lg-12">
                                    <div id="divAllTag"></div>

                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.H1, "H1", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.H1, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2"> @Resource.Lang.Menu </label>
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Url, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.CustomLabel, @Resource.Lang.Address, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.CustomLabel, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Title, Resource.Lang.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                </div>
                            </div>
                            <div class=" form-group">
                                @Html.LabelFor(model => model.Canonical, "Canonical جایگزین", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Canonical, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", autofocus = "on" } })
                                    @Html.ValidationMessageFor(model => model.Canonical, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class=" form-group">
                                @Html.LabelFor(model => model.NoIndex, "NoIndex در Robots", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.NoIndex)
                                    @Html.ValidationMessageFor(model => model.NoIndex, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class=" form-group">
                                @Html.LabelFor(model => model.NoFollow, "NoFollow در Robots", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.NoFollow)
                                    @Html.ValidationMessageFor(model => model.NoFollow, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @foreach (WebsiteLanguage lang in BaseLanguage.GetWebsiteLanguages())
                            {
                                if (lang.Language.Label != Enum_Lang.FA.ToString())
                                {
                                    ProductSubCategoryLanguage categorySubLanguage = Model.ProductSubCategoryLanguage.FirstOrDefault(p => p.LanguageId == lang.LanguageId);

                        <fieldset lang-value="@lang.Language.Label.ToLower()" class="ltr-fieldset">

                            <input type="hidden" lang-name="LanguageId" value="@lang.LanguageId" />
                            <legend>@lang.Language.Label</legend>
                            <div class="form-group">
                                <label class="control-label col-md-2">@Resource.Lang.Name (@lang.Language.Name)</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="Name" id="Name@(lang.Language.Label)" class="form-control" autocomplete="off" value="@( categorySubLanguage != null ? categorySubLanguage.Name : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">@Resource.Lang.Summery</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="description" id="description@(lang.Language.Label)" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.description : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">Min Summery</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="MinDescription" id="MinDescription@(lang.Language.Label)" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.MinDescription : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">body</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="body" id="body@(lang.Language.Label)" codeprocess="editor" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.body : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">landing-text</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="landing-text" id="landing-text@(lang.Language.Label)" codeprocess="editor" class="form-control" autocomplete="off" autofocus="autofocus" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">@Resource.Lang.Menu</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="Url" id="Url@(lang.Language.Label)" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.Url : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">H1</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="H1" id="H@(lang.Language.Label)" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.H1 : "")" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-2">@Resource.Lang.Title</label>
                                <div class="col-md-10">
                                    <input type="text" lang-name="Title" id="Title@(lang.Language.Label)" class="form-control" autocomplete="off" value="@(categorySubLanguage != null ? categorySubLanguage.Title : "")" />
                                </div>
                            </div>


                        </fieldset>
                                }
                            }
                        </fieldset>
                        

                        <div class="devider-15"></div>
                        <div class="form-group">
                            <div class="col-md-12 text-center">
                                <input id="btnSubmit" type="submit" value=@Resource.Lang.Register class="btn btn-success" />
                                <span class="btn btn-inverse">@Html.ActionLink(Resource.Lang.Back, "index")</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 no-padding-left">
    <div class="row">
        <div class="col-sm-8">
            <fieldset>
                <legend>@Resource.Lang.Image</legend>
                @if (Model.PictureId != null)
                {
                    <input id="uplFile" type="file" class="dropify" name="file" codeprocess="upload" data-height="230" data-default-file="@Model.Picture.GetUrl()" />
                }
                else
                {
                    <input id="uplFile" type="file" class="dropify" name="file" codeprocess="upload" data-height="230" />
                }
            </fieldset>
        </div>
        <div class="col-sm-4">
            <fieldset>
                <legend>@Resource.Lang.Icon</legend>
                @if (Model.IconId != null)
                {
                    <input id="uplFile1" type="file" class="dropify" name="file1" codeprocess="upload" data-height="230" UploadType="2" data-default-file="@Model.Picture1.GetUrl()" />
                }
                else
                {
                    <input id="uplFile1" type="file" class="dropify" name="file1" codeprocess="upload" data-height="230" UploadType="2" />
                }
            </fieldset>
        </div>

    </div>
</div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>


@section Header {
    <link rel="stylesheet" type="text/css" href="~/assets/plugins/fileuploads/css/dropify.min.css" />
}


@section Script {
    <script src="~/assets/plugins/tinymce/tinymce.min.js"></script>
    <script src="~/assets/plugins/fileuploads/js/dropify.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            UpdateTagSubcategory(@Model.ID);
            $("#CategoryId").change();
            initializeProductSubCategoryScript();
        });
    </script>
}

