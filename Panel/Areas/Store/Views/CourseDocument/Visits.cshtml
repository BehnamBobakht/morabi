@using System.Linq
@model Panel.Areas.Store.Models.CourseDocumentVisitsModel
@{ViewBag.Title="گزارش مطالعه «"+Model.DocumentTitle+"»";Layout="~/Views/Shared/Layout.cshtml";}
<div class="col-sm-12"><div class="card-box"><div class="clearfix"><h3 class="pull-right">@ViewBag.Title</h3><a class="btn btn-default pull-left" href="@Url.Action("Index")">بازگشت</a></div>
<form method="get" class="row"><input type="hidden" name="id" value="@Model.DocumentId"/><div class="form-group col-md-9"><label>جست‌وجوی نام، شماره تماس یا کد ملی</label><input class="form-control" name="search" value="@Model.Search"/></div><div class="form-group col-md-3"><label>&nbsp;</label><button class="btn btn-primary form-control">جست‌وجو</button></div></form>
<div class="table-responsive"><table class="table table-striped table-bordered"><thead><tr><th>#</th><th>کاربر</th><th>شماره تماس</th><th>کد ملی</th><th>وضعیت</th><th>اولین مطالعه</th><th>آخرین مطالعه</th></tr></thead><tbody>
@foreach(var item in Model.Visits){<tr><td>@item.AccountId</td><td>@item.FullName</td><td>@item.Mobile</td><td>@item.NationalCode</td><td>مشاهده‌شده</td><td>@item.FirstVisitDateTime.ToString("yyyy/MM/dd HH:mm")</td><td>@item.LastVisitDateTime.ToString("yyyy/MM/dd HH:mm")</td></tr>}
@if(!Model.Visits.Any()){<tr><td colspan="7" class="text-center">هنوز کاربری این PDF را مطالعه نکرده است.</td></tr>}
</tbody></table></div></div></div>
