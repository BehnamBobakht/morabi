@using System.Linq
@model Panel.Areas.Store.Models.CourseDocumentIndexModel
@{ViewBag.Title="PDFهای دوره‌ها";Layout="~/Views/Shared/Layout.cshtml";}
<div class="col-sm-12">
@if(TempData["MediaSuccess"]!=null){<div class="alert alert-success">@TempData["MediaSuccess"]</div>}
@if(TempData["MediaError"]!=null){<div class="alert alert-danger">@TempData["MediaError"]</div>}
<div class="card-box"><div class="clearfix"><h3 class="pull-right">PDFهای دوره‌ها</h3><a class="btn btn-success pull-left" href="@Url.Action("Form")">افزودن PDF</a></div>
<form method="get" class="row"><div class="form-group col-md-4"><label>جست‌وجو</label><input class="form-control" name="search" value="@Model.Search" /></div><div class="form-group col-md-4"><label>فیلتر دوره</label>@Html.DropDownListFor(x=>x.ProductId,Model.Products,"همه دوره‌ها",new{@class="form-control selectpicker",data_live_search="true"})</div><div class="form-group col-md-4"><label>&nbsp;</label><button class="btn btn-primary form-control">نمایش</button></div></form>
<div class="table-responsive"><table class="table table-striped table-bordered"><thead><tr><th>#</th><th>دوره</th><th>عنوان</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td>@item.ID</td><td>@item.ProductTitle</td><td>@item.Title</td><td>@item.SortOrder</td><td>@(item.Active?"فعال":"غیرفعال")</td><td><a class="btn btn-info btn-xs" href="@Url.Action("Visits",new{id=item.ID})">گزارش مشاهده</a> <a href="@Url.Action("Form",new{id=item.ID})">ویرایش</a><form method="post" action="@Url.Action("Delete")" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ID"/><button class="btn btn-link" onclick="return confirm('این PDF حذف شود؟')">حذف</button></form></td></tr>}
@if(!Model.Items.Any()){<tr><td colspan="6" class="text-center">موردی ثبت نشده است.</td></tr>}
</tbody></table></div></div></div>
@section Header{<link rel="stylesheet" href="@Url.Content("~/Assets/css/bootstrap-select.css")"/>}
@section Script{<script src="@Url.Content("~/Assets/js/bootstrap-select.js")"></script><script>$(function(){$('#ProductId').selectpicker({liveSearch:true,noneResultsText:'دوره‌ای پیدا نشد'});});</script>}
