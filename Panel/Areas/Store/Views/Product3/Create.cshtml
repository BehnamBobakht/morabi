                                {
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="ProductOptionId" class="control-label col-md-4">@Resource.Lang.ProductOption</label>
                                            <div class="col-md-8">
                                                @Html.DropDownList("ProductOptionId", null, htmlAttributes: new { @class = "form-control" })
                                            </div>
                                        </div>
                                    </div>
                                }

