                                                    <label class="form-check-label" for="IsCopyF">خیر</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="IsCopy" id="IsCopyT" value="true">
                                                    <label class="form-check-label" for="IsCopyT">بلی</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
