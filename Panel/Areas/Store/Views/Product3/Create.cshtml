                                            @Html.LabelFor(model => model.MaxOrderCount, Resource.Lang.MaxOrderCount, htmlAttributes: new { @class = "control-label col-md-4" })
                                            <div class="col-md-8">
                                                @Html.EditorFor(model => model.MaxOrderCount, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    </div>

                                }
                                else
                                {
                                    @Html.HiddenFor(model => model.MaxOrderCount)
                                }
