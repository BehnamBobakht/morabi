@using DataLayer.Base;
@using DataLayer.Entities;
@model IEnumerable<DataLayer.Entities.PaymentCertificate>
@{
    ViewBag.Title = "لیست درخواست گواهی";
    Layout = "~/Views/Shared/Layout.cshtml";
    List<PaymentCertificate> list = Model.ToList();
    string index = ViewBag.PageIndex;
    string pageSize = ViewBag.PageSize;
    string name = ViewBag.Name;
    string nationalCode = ViewBag.NationalCode;
    string mobile = ViewBag.Mobile;
    string type = ViewBag.Type;

    int TotalCount = ViewBag.TotalCount;
    int CurrentIndex = index.IsInteger() ? index.GetInteger() : 1;
    int PageSize = pageSize.IsInteger() ? pageSize.GetInteger() : 10;
    int StartIndex = CurrentIndex > 4 ? CurrentIndex - 4 : 1;
    int EndIndex = (TotalCount / PageSize);
    int Mod = (TotalCount % PageSize);
    EndIndex = Mod > 0 ? EndIndex + 1 : EndIndex; ;
}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    @*<script type="text/javascript">
            TableManageButtons.init();
        </script>*@
}
<div>
    <div class="col-sm-12">
        <form method="get" id="account-form" action="~/store/product/PaymentCertificate">
            <input type="hidden" id="id" name="id" class="form-control" value="@ViewBag.Id" />

            <div class="list_search row card-box m-0">
                <div class="form-group mb-0 col-md-4">
                    <label for="orderid" class="control-labe">@Resource.Lang.Name</label>
                    <input id="name" name="name" class="form-control" value="@name" />
                </div>
                <div class="form-group mb-0 col-md-4">
                    <label for="orderid" class="control-labe">@Resource.Lang.NationalCode</label>
                    <input id="nationalCode" name="nationalCode" class="form-control" value="@nationalCode" />

                </div>
                <div class="form-group mb-0 col-md-4">
                    <label for="orderid" class="control-labe">@Resource.Lang.Mobile</label>
                    <input id="mobile" name="mobile" class="form-control" value="@mobile" />

                </div>
                <div class="form-group mb-0 col-md-4">
                    <label for="orderid" class="control-labe">نوع</label>
                    <select id="type" name="type" class="form-control">
                        <option value="">همه</option>

                        <option value="1">گواهی آنلاین</option>
                        <option value="2">گواهی فیزیکی</option>

                    </select>
                </div>
                <div class="form-group mb-0 col-md-2">
                    <input type="submit" class="btn btn-success col-xs-12" value=@Resource.Lang.Search>
                </div>
            </div>
        </form>
        <div class="card-box table-responsive">
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th class="first">#</th>
                        <th>نام و نام خانوادگی</th>
                        <th>شماره تماس</th>
                        <th>کد ملی</th>

                        <th>تاریخ</th>
                        <th>نوع</th>

                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < list.Count; i++)
                    {
                        PaymentCertificate item = list[i];
                        <tr>
                            <td>@(i+1)</td>
                            <td>@item.Account.FullName @item.Account.LatName</td>
                            <td>@item.Account.Mobile</td>
                            <td>@item.Account.NationalCode</td>
                            <td>@item.Datetime.ToPersian()</td>

                            @if (item.Type == 1)
                            {
                                <td>گواهی آنلاین</td>
                            }
                            else
                            {
                                <td>گواهی فیزیکی</td>
                            }


                        </tr>
                    }
                </tbody>
            </table>
            <div class="dataTables_paginate paging_simple_numbers" id="datatable-buttons_paginate">


                <ul class="pagination">
                    <li class="paginate_button previous" aria-controls="datatable-buttons">
                        <a href="@Url.Action("PaymentCertificate", new {
                            @id = ViewBag.Id,

                                    @name = name,
                                    @nationalCode=nationalCode,
                                    @mobile=mobile,
                                    @type=type,
                            @pageIndex = 1,
                            @pageSize = pageSize

                        })">@Resource.Lang.FirstPage</a>
                    </li>
                    @for (int i = StartIndex; i <= EndIndex && i <= CurrentIndex + 4; i++)
                    {
                        var active = CurrentIndex == i ? "active" : "";
                        <li class="paginate_button @active" aria-controls="datatable-buttons">
                            <a href="@Url.Action("PaymentCertificate", new {
                                    @id = ViewBag.Id,

                                    @name = name,
                                    @nationalCode=nationalCode,
                                    @mobile=mobile,
                                    @type=type,
                                    @pageIndex = i,
                                    @pageSize = pageSize
                            })">@(i.ToPersian())</a>
                        </li>
                    }
                    @if (CurrentIndex < EndIndex)
                    {
                        <li class="paginate_button previous" aria-controls="datatable-buttons">
                            <a href="@Url.Action("PaymentCertificate", new
                                    {
                                    @id = ViewBag.Id,

                                    @name = name,
                                    @nationalCode=nationalCode,
                                    @mobile=mobile,
                                    @type=type,

                                    @pageIndex = EndIndex,
                                    @pageSize = pageSize
                            })">@Resource.Lang.LastPage</a>
                        </li>
                    }
                    else
                    {
                        <li class="paginate_button previous disabled" aria-controls="datatable-buttons">
                            <a href="#">@Resource.Lang.LastPage</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <!-- end col -->
</div>
