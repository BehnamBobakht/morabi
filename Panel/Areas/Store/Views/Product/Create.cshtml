                                {
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Weight, Resource.Lang.Weight, htmlAttributes: new { @class = "control-label col-md-4" })
                                            <div class="col-md-8">
                                                @Html.EditorFor(model => model.Weight, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (setting.Earnest > 0)
                                {
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.HasEarnest, Resource.Lang.EarnestPayment, htmlAttributes: new { @class = "control-label col-md-4" })
                                            <div class="col-md-8">
                                                @Html.EditorFor(model => model.HasEarnest)
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (setting.HasColor)
                                {
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">@Resource.Lang.ChooseColor</label>
                                            <div class="col-md-10">
                                                <div id="div-color-part">
                                                    <div id="color-container">
                                                        @Html.Action("Colors", new { productTypeId = Model.ProductTypeId, productId = Model.ID, ColorIds = Model.ColorIds })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (setting.HasSize)
                                {
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">@Resource.Lang.ChooseSize</label>
                                            <div class="col-md-10">
                                                <div id="div-size-part">
                                                    <div id="size-container">
                                                        @Html.Action("Sizes", new { productTypeId = Model.ProductTypeId, productId = Model.ID, SizeIds = Model.SizeIds })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }


                                @if (setting.HasProductOption)
                                {
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="ProductOptionId" class="control-label col-md-2">@Resource.Lang.ProductOption</label>
                                            <div class="col-md-10">
                                                <div id="product-option-dropDown">
                                                    @Html.Action("ProductOptionDropDown", "ProductOption", new { area = "store", typeId = Model.ProductTypeId, value = Model.ProductOptionId })
                                                </div>
                                                <div id="product-option-item-container">
                                                    @Html.Action("ProductOptionItems", "ProductOptionItem", new { area = "store", productOptionId = Model.ProductOptionId, productId = Model.ID, optionItemIds = Model.OptionItemIds })
                                                </div>
                                            </div>

                                        </div>


                                    </div>
                                }
                                @if (setting.HasSeo)
                                {
                                    <div class="clear"></div>
                                    <fieldset>
                                        <legend>@Resource.Lang.ManagerSeo</legend>
                                    </fieldset>
                                    <div class="col-sm-12 ">

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.H1, "H1", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.H1, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Title, Resource.Lang.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Url, @Resource.Lang.Address, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.Url, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.MetaTagDescription, @Resource.Lang.MetaDescription, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.TextAreaFor(model => model.MetaTagDescription, new { @class = "form-control", @autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.Canonical, "Canonical جایگزین", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.Canonical, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", autofocus = "on" } })
                                                @Html.ValidationMessageFor(model => model.Canonical, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.NoIndex, "NoIndex در Robots", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.NoIndex)
                                                @Html.ValidationMessageFor(model => model.NoIndex, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 ">

                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.NoFollow, "NoFollow در Robots", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.NoFollow)
                                                @Html.ValidationMessageFor(model => model.NoFollow, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.ProductLanguages.Any())
                                {
                                    <div class="clear"></div>

                                    <fieldset>
                                        <legend>@Resource.Lang.Languages</legend>
                                    </fieldset>
                                    for (int i = 0; i < Model.ProductLanguages.Count(); i++)
                                    {
                                        <div class=" form-group">
                                            <strong class="col-md-2 font-weight-bold"> </strong>
                                            <div class="col-md-10">
                                                <h3 class="col-md-2">@Model.ProductLanguages[i].LanguageName</h3>

                                                @Html.HiddenFor(model => model.ProductLanguages[i].LanguageId)
                                                @Html.HiddenFor(model => model.ProductLanguages[i].LanguageName)
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Name, Resource.Lang.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].Name, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].H1, "h1", htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].H1, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Title, Resource.Lang.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].Title, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Summary, Resource.Lang.Summery, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].Summary, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>

                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Url, Resource.Lang.Address, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].Url, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Description, Resource.Lang.MetaDescription, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.TextAreaFor(model => model.ProductLanguages[i].Description, new { @class = "form-control", @autocomplete = "off" })
                                            </div>
                                        </div>
                                        <div class=" form-group">
                                            @Html.LabelFor(model => model.ProductLanguages[i].Body, Resource.Lang.Description, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.ProductLanguages[i].Body, new { htmlAttributes = new { @codeprocess = "editor", @class = "form-control", @autocomplete = "off" } })
                                            </div>
                                        </div>
                                    }

                                }
                                <div class="clear"></div>

                                <fieldset>
                                    <legend>@Resource.Lang.Status</legend>
                                </fieldset>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Active, Resource.Lang.ActiveDeactive, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            <select name="Active" id="Active" class="form-control">
                                                <option value="True">@Resource.Lang.Active</option>
                                                <option value="False">@Resource.Lang.Deactive</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StatusId, Resource.Lang.Status, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownList("StatusId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </fieldset>


                        <div class="devider-15"></div>
                    </div>
                    <div class="col-sm-6 no-padding-left">
                        @Html.Partial("_Pictures", Model)
                        <div class="row ">
                            <fieldset>
                                <legend>@Resource.Lang.Review</legend>

                            </fieldset>

                            <div class="review-box">
                                @foreach (var r in Model.Reviews)
                                {
                                    <text>@Html.Partial("_Review", r)</text>
                                }
                            </div>
                            <a class="btn btn-primary add-review w-100">@Resource.Lang.New</a>
                        </div>

                    </div>
                    @if (setting.HasService)
                    {

                        <div class="col-sm-6 no-padding-left">
                            <div class="devider-15"></div>

                            <div class="row map-div">

                                <div class="col-sm-12  mt-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsService, Resource.Lang.Service, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.EditorFor(model => model.IsService)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12  mt-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Latitude, Resource.Lang.Latitude, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.EditorFor(model => model.Latitude, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Longitude, Resource.Lang.Longitude, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.EditorFor(model => model.Longitude, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12 ">
                                    <div class="form-group">
                                        @Html.Label("نقشه", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.Partial("~/Views/Partial/LocationPicker.cshtml")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-sm-12">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-1 col-md-11">
                                <input id="btnSubmit" type="submit" value=@Resource.Lang.Register class="btn btn-success" />
                                <span class="btn btn-inverse">@Html.ActionLink(Resource.Lang.Back, "Index")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
}

