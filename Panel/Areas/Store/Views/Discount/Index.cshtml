@using DataLayer.Base;
@using DataLayer.ViewModels;
@model DiscountSearchVm
@{

    ViewBag.Title = Resource.Lang.DistcountsList;
    Layout = "~/Views/Shared/Layout.cshtml";
    int TotalCount = Model.TotalCount;
    int CurrentIndex = Model.PageIndex;
    int PageSize = Model.PageSize;
    int StartIndex = CurrentIndex > 4 ? CurrentIndex - 4 : 1;
    int EndIndex = (TotalCount / PageSize);
    int Mod = (TotalCount % PageSize);
    EndIndex = Mod > 0 ? EndIndex + 1 : EndIndex;
}

@section Footer {
    @*@Html.Action("TableScript", "Layout", new { area = "" })*@
}
@section Script {
    @*<script type="text/javascript">
            TableManageButtons.init();
        </script>*@
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("index", new { area = "store" })" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.Back></a>
            <a href="@Url.Action("create", new { area = "store", controller = "discount" })" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <div class="row">
                <div class="col-sm-2">
                    <span class="control-label font-bold">@Resource.Lang.Type</span>
                    <div>
                        @Html.DropDownList("typeId", null, Resource.Lang.Select, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-2">
                    <span class="control-label font-bold">@Resource.Lang.Seller</span>
                    <div>
                        @Html.DropDownList("storeId", null, Resource.Lang.Select, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>

                <div class="col-sm-2">
                    <span class="control-label font-bold">@Resource.Lang.Name</span>
                    <div>
                        <input type="text" class="form-control" name="name" placeholder=@Resource.Lang.Name value="@Model.Name" />
                    </div>
                </div>
                <div class="col-sm-2">
                    <span class="control-label font-bold">@Resource.Lang.Status</span>
                    <div>
                        <select class="form-control" name="active">
                            <option>@Resource.Lang.All</option>
                            <option value="true" @(Model.Active == true ? "selected" : "")>@Resource.Lang.Active</option>
                            <option value="false" @(Model.Active == false ? "selected" : "")>@Resource.Lang.Deactive</option>
                        </select>

                    </div>
                </div>
                <div class="devider-15"></div>
            </div>
            @if (Model.TotalCount > 0)
            {
                <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                    <thead>
                        <tr>
                            <th class="first">#</th>
                            <th>@Resource.Lang.DiscountGroup  </th>
                            <th>@Resource.Lang.Date</th>


                            <th>@Resource.Lang.Seller</th>
                            <th>@Resource.Lang.DiscountType  </th>

                            <th>@Resource.Lang.Name</th>
                            <th>@Resource.Lang.Amount / @Resource.Lang.Percent</th>
                            <th>@Resource.Lang.Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Discounts)
                        {
                            <tr>
                                <td></td>
                                <td>@item.GroupName</td>
                                <td>
                                    @(item.StartDatetime.HasValue ? Resource.Lang.From + " " + item.StartDatetime.ToPersian() : "")
                                    @(item.EndDatetime.HasValue ? Resource.Lang.To + " " + item.EndDatetime.ToPersian() : "")
                                </td>
                                <td>@item.StoreName</td>

                                <td>@item.TypeName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProductBrandName))
                                    {
                                        <span>@item.ProductBrandName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ProductTypeName))
                                    {
                                        <span>@item.ProductTypeName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ProductCategoryName))
                                    {
                                        <span> - @item.ProductCategoryName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ProductSubCategoryName))
                                    {
                                        <span> - @item.ProductSubCategoryName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ProductName) && string.IsNullOrEmpty(item.VarityName))
                                    {
                                        <span> - @item.ProductName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.VarityName))
                                    {
                                        <span> - @item.VarityName</span>
                                    }
                                </td>
                                @if (item.PriceValue != null)
                                {
                                    <td>@item.PriceValue.Value.GetCurrencyFormat().ToPersian() @Resource.Lang.Toman</td>
                                }
                                else if (item.PercentValue != null)
                                {
                                    <td>@item.PercentValue @Resource.Lang.Percent</td>
                                }
                            <td>
                                @if (item.Active)
                                {
                                    <span>@Resource.Lang.Active</span>
                                }
                                else
                                {
                                    <span>@Resource.Lang.Deactive</span>
                                }
                            </td>
                                <td>
                                    @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                                    @Html.ActionLink(Resource.Lang.Delete, "delete", new { id = item.ID })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="dataTables_paginate paging_simple_numbers" id="datatable-buttons_paginate">
                    <ul class="pagination">
                        @if (StartIndex > 1)
                        {
                            <li class="paginate_button previous" aria-controls="datatable-buttons">
                                <a href="@Url.Action("index", new
                                    {
                                        storeId = Model.StoreId,
                                        typeId = Model.TypeId,
                                        name = Model.Name,
                                        active = Model.Active,
                                        index = 1,
                                    })">@Resource.Lang.FirstPage</a>
                                </li>
                            }
                            else
                            {
                                <li class="paginate_button previous disabled" aria-controls="datatable-buttons">
                                    <a href="#">@Resource.Lang.FirstPage</a>
                                </li>
                            }
                        @for (int i = StartIndex; i <= EndIndex && i <= CurrentIndex + 4; i++)
                        {
                            var activeIndex = CurrentIndex == i ? "active" : "";
                            <li class="paginate_button @activeIndex" aria-controls="datatable-buttons">
                                <a href="@Url.Action("index", new
                                    {
                                        storeId = Model.StoreId,
                                        typeId = Model.TypeId,
                                        name = Model.Name,
                                        active = Model.Active,
                                        index = i,
                                    })">@(i.ToPersian())</a>
                                </li>
                            }
                        @if (CurrentIndex < EndIndex)
                        {
                            <li class="paginate_button previous" aria-controls="datatable-buttons">
                                <a href="@Url.Action("index", new
                                    {
                                        storeId = Model.StoreId,
                                        typeId = Model.TypeId,
                                        name = Model.Name,
                                        active = Model.Active,
                                        index = EndIndex,
                                    })">@Resource.Lang.LastPage</a>
                                </li>
                            }
                            else
                            {
                                <li class="paginate_button previous disabled" aria-controls="datatable-buttons">
                                    <a href="#">@Resource.Lang.LastPage</a>
                                </li>
                            }
                    </ul>
                </div>
            }
            else
            {
                <p class="alert alert-danger">@Resource.Notify.NothingFound</p>
            }
        </div>
    </div>
    <!-- end col -->
</div>
