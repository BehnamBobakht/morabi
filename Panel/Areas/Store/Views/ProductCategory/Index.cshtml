@using DataLayer.Base;
@model IEnumerable<DataLayer.ViewModels.ProductCategoryVm>
@{
    ViewBag.Title = Resource.Lang.ListofProductCategories;
    Layout = "~/Views/Shared/Layout.cshtml";
    var setting = BaseWebsite.WebsiteSetting;

}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    <script type="text/javascript">
        TableManageButtons.init();
    </script>
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th>@Resource.Lang.Code</th>
                        <th>@Resource.Lang.DisplayPriority</th>
                        <th>@Resource.Lang.Name</th>
                        <th>@Resource.Lang.TypeProduct</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            @if (item.SyncId != null)
                            {
                                if (item.SyncId.IsGuid() == false)
                                {
                                    <td>@item.SyncId</td>
                                }
                                else
                                {
                                    <td>@item.ID</td>
                                }
                            }
                            else
                            {
                                <td>@item.ID</td>
                            }
                            <td>
                                @item.Priority
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.ProductTypeName)</td>
                            <td>

                                @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                                @if (setting.HasProductSubCategory)
                                {@Html.ActionLink(Resource.Lang.Subordinates, "index", new { @controller = "productsubcategory", @categoryId = item.ID })<span>|</span>} 
                                @if (setting.HasCustomFields)
                                {@Html.ActionLink(Resource.Lang.PrivateFields, "index", new { @controller = "customproducttype", @categoryId = item.ID })<span>|</span>}
                                @Html.ActionLink(Resource.Lang.Detail, "details", new { id = item.ID }) |
                                @Html.ActionLink(Resource.Lang.Delete, "delete", new { id = item.ID })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
