@using DataLayer.Base;
@model IEnumerable<DataLayer.Entities.SmartOfferQuestion>
@{
    ViewBag.Title = Resource.Lang.Question;
    var setting = BaseWebsite.WebsiteSetting;

    Layout = "~/Views/Shared/Layout.cshtml";
}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    <script type="text/javascript">
        TableManageButtons.init();
    </script>
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                       
                        <th>@Resource.Lang.ID</th>
                        <th>@Resource.Lang.Question</th>
                     
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ID)</td>
                            
                            <td>
                                @item.Question
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Question)</td>
                            <td>
                                @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID })<span>|</span>
                               
                               @Html.ActionLink(Resource.Lang.Answer, "index", new { @controller = "SmartOfferAnswer", @id = item.ID })<span>|</span> 
                                @Html.ActionLink(Resource.Lang.Delete, "delete", new { id = item.ID })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
