@using DataLayer.Base;
@using DataLayer.Entities;
@model DataLayer.ViewModels.StoreProductQuantityVm
@{
    ViewBag.Title = Model.FullName;
    Layout = "~/Views/Shared/Layout.cshtml";
    var list = Model.PriceRange.OrderBy(s => s.StartCount).ToList();
}
@section Footer {
    @*@Html.Action("TableScript", "Layout", new { area = "" })*@
}
@section Script {
    @*<script type="text/javascript">
        TableManageButtons.init();
    </script>*@
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("AddToStore", "Product",new { area="store",productid=Model.ProductId,storeid=Model.Store.ID})" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.Back></a>
            <a href="@Url.Action("create", new { id = Model.ID })" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                       
                        <th>#</th>
                        <th>@Resource.Lang.Name</th>
                        <th>@Resource.Lang.From</th>
                        <th>@Resource.Lang.To</th>
                        <th>@Resource.Lang.Price (@Resource.Lang.Toman)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for(int i= 0;i<Model.PriceRange.Count();i++)
                    {
                        var item = list[i];
                    <tr>

                        <td>@(i+1)</td>
                        <td>@Model.FullName</td>

                        <td>@item.StartCount.ToPersian()</td>
                        <td>@(item.EndCount != null ? item.EndCount.ToPersian() : Resource.Lang.AndMore)</td>
                        <td>@item.Price.GetCurrencyFormat().ToPersian()</td>

                        <td>
                            @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                            @Html.ActionLink(Resource.Lang.Delete, "delete", new { id = item.ID })
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
