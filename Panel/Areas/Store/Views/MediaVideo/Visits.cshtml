@using System.Linq
@model Panel.Areas.Store.Models.MediaVisitIndexModel
@{
    ViewBag.Title = "گزارش مشاهده «" + Model.MediaTitle + "»";
    Layout = "~/Views/Shared/Layout.cshtml";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
<div class="col-sm-12">
    <div class="card-box">
        <div class="clearfix">
            <h3 class="pull-right">@ViewBag.Title <small class="label label-info">جمع کل بازدید: @Model.TotalCount</small></h3>
            <a class="btn btn-default pull-left" href="@(Model.Source == "course" ? Url.Action("Index") : Url.Action("Sessions", new { id = Model.ParentId }))">بازگشت</a>
        </div>
        <form method="get" class="row">
            <input type="hidden" name="source" value="@Model.Source" />
            <input type="hidden" name="id" value="@Model.MediaId" />
            <div class="form-group col-md-9">
                <label>جست‌وجوی نام، شماره تماس یا کد ملی</label>
                <input class="form-control" name="search" value="@Model.Search" />
            </div>
            <div class="form-group col-md-3">
                <label>&nbsp;</label>
                <button class="btn btn-primary form-control">جست‌وجو</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>کاربر</th>
                        <th>شماره تماس</th>
                        <th>کد ملی</th>
                        <th>وضعیت</th>
                        <th>آخرین مشاهده</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Visits)
                    {
                        <tr>
                            <td>@item.AccountId</td>
                            <td>@item.FullName</td>
                            <td>@item.Mobile</td>
                            <td>@item.NationalCode</td>
                            <td>مشاهده‌شده</td>
                            <td>@item.LastVisitDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                        </tr>
                    }
                    @if (!Model.Visits.Any())
                    {
                        <tr><td colspan="6" class="text-center">هنوز هیچ کاربری این ویدئو را مشاهده نکرده است.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <ul class="pagination">
                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="@(p == Model.PageIndex ? "active" : "")">
                        <a href="@Url.Action("Visits", new { source = Model.Source, id = Model.MediaId, search = Model.Search, page = p })">@p</a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
