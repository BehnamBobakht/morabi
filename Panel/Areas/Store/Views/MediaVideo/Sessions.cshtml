@model Panel.Areas.Store.Models.CollectionSessionsIndexModel
@{
    ViewBag.Title = "جلسات مجموعه «" + Model.Collection.Title + "»";
    Layout = "~/Views/Shared/Layout.cshtml";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
<div class="col-sm-12">
    @if (TempData["MediaSuccess"] != null) { <div class="alert alert-success">@TempData["MediaSuccess"]</div> }
    @if (TempData["MediaError"] != null) { <div class="alert alert-danger">@TempData["MediaError"]</div> }
    <div class="card-box">
        <p><a class="btn btn-success" href="@Url.Action("SessionForm", new { collectionId = Model.Collection.ID })">افزودن جلسه</a> <a class="btn btn-default" href="@Url.Action("Collections")">بازگشت</a></p>
        <form method="get" class="row"><input type="hidden" name="id" value="@Model.Collection.ID" /><div class="form-group col-md-9"><label>جست‌وجوی عنوان یا توضیحات</label><input class="form-control" name="search" value="@Model.Search" /></div><div class="form-group col-md-3"><label>&nbsp;</label><button class="btn btn-primary form-control">جست‌وجو</button></div></form>
        <div class="table-responsive"><table class="table table-striped table-bordered"><thead><tr><th>کاور</th><th>#</th><th>عنوان</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead><tbody>
        @foreach (var item in Model.Sessions) { <tr><td>@if (!string.IsNullOrWhiteSpace(item.PictureUrl)) { <img src="@Url.Content(item.PictureUrl)" style="width:80px;height:48px;object-fit:cover" /> }</td><td>@item.ID</td><td>@item.Title</td><td>@item.SortOrder</td><td>@(item.Active ? "فعال" : "غیرفعال")</td><td><a class="btn btn-info btn-xs" href="@Url.Action("Visits", new { source = "collection", id = item.ID })">گزارش مشاهده کاربران</a> | <a href="@Url.Action("SessionForm", new { collectionId = Model.Collection.ID, id = item.ID })">ویرایش</a><form method="post" action="@Url.Action("DeleteSession")" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ID" /><input type="hidden" name="collectionId" value="@Model.Collection.ID" /><button type="submit" class="btn btn-link" onclick="return confirm('این جلسه حذف شود؟')">حذف</button></form></td></tr> }
        @if (!Model.Sessions.Any()) { <tr><td colspan="6" class="text-center">جلسه‌ای ثبت نشده است.</td></tr> }
        </tbody></table></div>
        @if (totalPages > 1) { <ul class="pagination">@for (var p = 1; p <= totalPages; p++) { <li class="@(p == Model.PageIndex ? "active" : "")"><a href="@Url.Action("Sessions", new { id = Model.Collection.ID, search = Model.Search, page = p })">@p</a></li> }</ul> }
    </div>
</div>