@model Panel.Areas.Store.Models.MediaVideoIndexModel
@{
    ViewBag.Title = "ویدئوهای دوره‌ها";
    Layout = "~/Views/Shared/Layout.cshtml";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
<div class="col-sm-12">
    @if (TempData["MediaSuccess"] != null) { <div class="alert alert-success">@TempData["MediaSuccess"]</div> }
    @if (TempData["MediaError"] != null) { <div class="alert alert-danger">@TempData["MediaError"]</div> }
    <div class="card-box">
        <div class="clearfix">
            <h3 class="pull-right">ویدئوهای دوره‌ها</h3>
            <a class="btn btn-success pull-left" href="@Url.Action("CourseForm")">افزودن ویدئوی دوره</a>
        </div>
        <form method="get" class="row">
            <div class="form-group col-md-4"><label>جست‌وجو</label><input class="form-control" name="search" value="@Model.Search" /></div>
            <div class="form-group col-md-4"><label>فیلتر دوره</label>@Html.DropDownListFor(x => x.ProductId, Model.Products, "همه دوره‌ها", new { @class = "form-control selectpicker", data_live_search = "true" })</div>
            <div class="form-group col-md-4"><label>&nbsp;</label><button class="btn btn-primary form-control">نمایش</button></div>
        </form>
        <div class="table-responsive"><table class="table table-striped table-bordered">
            <thead><tr><th>کاور</th><th>#</th><th>دوره</th><th>عنوان</th><th>ترتیب</th><th>نوع</th><th>بازدید کل</th><th>وضعیت</th><th>لینک مستقیم</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.CourseVideos) {
                <tr><td>@if (!string.IsNullOrWhiteSpace(item.PictureUrl)) { <img src="@Url.Content(item.PictureUrl)" style="width:80px;height:48px;object-fit:cover" /> }</td><td>@item.ID</td><td>@item.ProductName</td><td>@item.Title</td><td>@item.SortOrder</td><td>@(item.IsDemo ? "دمو" : "ویژه خریداران")</td><td>@item.VisitCount</td><td>@(item.Active ? "فعال" : "غیرفعال")</td><td><a class="btn btn-default btn-xs" target="_blank" href="https://morabiiran.com/media/courses/watch/@item.ProductId?sessionId=@item.ID">باز کردن / کپی لینک</a></td>
                    <td><a class="btn btn-info btn-xs" href="@Url.Action("Visits", new { source = "course", id = item.ID })">گزارش مشاهده کاربران</a> | <a href="@Url.Action("CourseForm", new { id = item.ID })">ویرایش</a>
                        <form method="post" action="@Url.Action("DeleteCourse")" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ID" /><button type="submit" class="btn btn-link" onclick="return confirm('این ویدئو حذف شود؟')">حذف</button></form>
                    </td></tr>
            }
            @if (!Model.CourseVideos.Any()) { <tr><td colspan="10" class="text-center">موردی ثبت نشده است.</td></tr> }
            </tbody>
        </table></div>
        @if (totalPages > 1) {
            <ul class="pagination">
            @for (var p = 1; p <= totalPages; p++) { <li class="@(p == Model.PageIndex ? "active" : "")"><a href="@Url.Action("Index", new { productId = Model.ProductId, search = Model.Search, page = p })">@p</a></li> }
            </ul>
        }
    </div>
</div>
@section Header {
    <link rel="stylesheet" href="@Url.Content("~/Assets/css/bootstrap-select.css")" />
}
@section Script {
    <script src="@Url.Content("~/Assets/js/bootstrap-select.js")"></script>
    <script>
        $(function () {
            $("#ProductId").attr("data-live-search", "true").selectpicker({ liveSearch: true, noneResultsText: "دوره‌ای پیدا نشد" });
        });
    </script>
}
