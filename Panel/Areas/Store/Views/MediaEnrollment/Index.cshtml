@using DataLayer.Entities
@model IEnumerable<Account>
@{
    ViewBag.Title = "افزودن دستی کاربران به دوره‌ها";
    Layout = "~/Views/Shared/Layout.cshtml";
    var pageIndex = (int)ViewBag.PageIndex;
    var pageSize = (int)ViewBag.PageSize;
    var totalCount = (int)ViewBag.TotalCount;
    var totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
}

<div class="card-box">
    <h3>افزودن دستی کاربران به دوره‌ها</h3>
    <p class="text-muted">یک یا چند دوره و یک یا چند کاربر را انتخاب کنید تا عضویت‌ها به‌صورت گروهی ثبت شوند.</p>

    @if (TempData["MediaSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["MediaSuccess"]</div>
    }
    @if (TempData["MediaError"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["MediaError"])</div>
    }

    <form method="get" action="@Url.Action("Index")" class="row list_search">
        <div class="form-group col-md-3">
            <label for="fullName">نام و نام خانوادگی</label>
            <input class="form-control" id="fullName" name="fullName" value="@ViewBag.FullName" />
        </div>
        <div class="form-group col-md-3">
            <label for="nationalCode">کد ملی</label>
            <input class="form-control" id="nationalCode" name="nationalCode" value="@ViewBag.NationalCode" inputmode="numeric" />
        </div>
        <div class="form-group col-md-3">
            <label for="mobile">شماره تماس</label>
            <input class="form-control" id="mobile" name="mobile" value="@ViewBag.Mobile" inputmode="tel" />
        </div>
        <div class="form-group col-md-3">
            <label>&nbsp;</label>
            <button type="submit" class="btn btn-success form-control">جست‌وجو</button>
        </div>
    </form>
</div>

<form method="post" action="@Url.Action("Enroll")">
    @Html.AntiForgeryToken()
    <div class="card-box">
        <div class="row">
            <div class="form-group col-md-8">
                <label for="productIds">دوره‌ها</label>
                @Html.ListBox("productIds", (MultiSelectList)ViewBag.Products, new { @class = "form-control selectpicker", required = "required", multiple = "multiple", data_live_search = "true", data_actions_box = "true", data_selected_text_format = "count > 3", title = "انتخاب یک یا چند دوره" })
            </div>
            <div class="form-group col-md-4">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary form-control" onclick="return confirm('عضویت دستی کاربران انتخاب‌شده ثبت شود؟')">
                    افزودن کاربران انتخاب‌شده به دوره‌های انتخاب‌شده
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th style="width:45px"><input type="checkbox" id="select-all" /></th>
                        <th>شناسه</th>
                        <th>نام و نام خانوادگی</th>
                        <th>کد ملی</th>
                        <th>شماره تماس</th>
                        <th>ایمیل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model)
                    {
                        <tr>
                            <td><input type="checkbox" name="accountIds" value="@account.ID" class="account-check" /></td>
                            <td>@account.ID</td>
                            <td>@account.FullName @account.LatName</td>
                            <td>@account.NationalCode</td>
                            <td>@account.Mobile</td>
                            <td>@account.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="clearfix">
            <span class="pull-right">تعداد کل: @totalCount</span>
            <ul class="pagination pull-left">
                @for (var page = 1; page <= totalPages && page <= 20; page++)
                {
                    <li class="@(page == pageIndex ? "active" : "")">
                        <a href="@Url.Action("Index", new {
                            fullName = ViewBag.FullName,
                            nationalCode = ViewBag.NationalCode,
                            mobile = ViewBag.Mobile,
                            pageIndex = page,
                            pageSize
                        })">@page</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</form>
@section Header {
    <link rel="stylesheet" href="@Url.Content("~/Assets/css/bootstrap-select.css")" />
}
@section Script {
    <script src="@Url.Content("~/Assets/js/bootstrap-select.js")"></script>
    <script>
        $(function () {
            $("#productIds").selectpicker({ liveSearch: true, actionsBox: true, noneResultsText: "دوره‌ای پیدا نشد", selectAllText: "انتخاب همه", deselectAllText: "حذف همه", countSelectedText: "{0} دوره انتخاب شده" });
        });
    </script>
    <script>
        (function () {
            var all = document.getElementById("select-all");
            if (!all) return;
            all.addEventListener("change", function () {
                Array.prototype.forEach.call(document.querySelectorAll(".account-check"), function (item) {
                    item.checked = all.checked;
                });
            });
        }());
    </script>
}

