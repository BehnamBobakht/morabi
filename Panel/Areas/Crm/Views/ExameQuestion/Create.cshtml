            <div class="col-sm-12">
                <div class="form-horizontal">
                    @*<div>
                            <div class="col-md-10 col-md-offset-2">
                                <div class="row">
                                    @Html.Partial("~/Views/Public/Message.cshtml", (ViewMessage)ViewBag.Message)
                                </div>
                            </div>
                        </div>*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelFor(model => model.ExameCourseId, "درس", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("ExameCourseId", null, Resource.Lang.Select, htmlAttributes: new { @class = "form-control category_id" })
                            @Html.ValidationMessageFor(model => model.ExameCourseId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @*
                        <div class="form-group">
                            <label for="CategoryId" class="control-label col-md-2">@Resource.Lang.Category</label>
                            <div class="col-md-10" id="category-dropDown">
                                @Html.Action("CategoryDropDown", "ExameCourseCategory", new { area = "crm", Id = Model.ExameCourseId, value = Model.ExameCourseCategoryId })
                            </div>
                        </div>*@

                    <div class="form-group">
                        @Html.LabelFor(model => model.Text, Resource.Lang.Question, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <textarea id="Text" class="form-control" name="Text" rows="5" cols="100"></textarea>

                            @*@Html.EditorFor(model => model.Text, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })*@
                            @Html.ValidationMessageFor(model => model.Text, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @*<textarea id="mytextarea"></textarea>*@
                    @*<div class="form-group">
                            @Html.LabelFor(model => model.Formula, "فرمول", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">

                                @Html.EditorFor(model => model.Formula, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @codeprocess = "editor2" } })
                                @Html.ValidationMessageFor(model => model.Formula, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                    <div class="form-group">
                        @Html.LabelFor(model => model.AnswerDetails, "پاسخ تشریحی", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @*<textarea id="AnswerDetails" class="form-control" name="AnswerDetails" rows="5" cols="100"></textarea>*@

                            @Html.EditorFor(model => model.AnswerDetails, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @codeprocess = "editor2" } })
                            @Html.ValidationMessageFor(model => model.AnswerDetails, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Active, Resource.Lang.Active, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Active, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                            @Html.ValidationMessageFor(model => model.Active, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.PictureId, Resource.Lang.Picture, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <input id="uplFile" type="file" class="dropify" name="file" codeprocess="upload-n" data-height="150" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
