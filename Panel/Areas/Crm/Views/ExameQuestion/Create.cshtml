    ViewBag.Title = "سوال " + exame.Name;
    Layout = "~/Views/Shared/Layout.cshtml";
}
@using (Html.BeginForm("create", "ExameQuestion", FormMethod.Post, new { enctype = "multipart/form-data" }))
