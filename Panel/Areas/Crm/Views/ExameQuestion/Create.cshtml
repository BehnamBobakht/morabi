@section Header {
    <link rel="stylesheet" type="text/css" href="/panel/Assets/plugins/fileuploads/css/dropify.min.css" />
}


@section Script {
    <script src="/panel/assets/plugins/fileuploads/js/dropify.min.js"></script>
    @*<script src="~/assets/plugins/tinymce/tinymce.min.js"></script>*@
    <script src="~/assets/plugins/tinymceV6/js/tinymce/tinymce.min.js"></script>

    <script src="~/assets/plugins/tinymce/plugins/eqneditor/eqneditor.js"></script>

    @*<script src="~/assets/plugins/tinymceV6/js/tinymce/tinymce.min.js"></script>
        <script src="~/assets/plugins/tinymceV6/js/tinymce/plugins/eqneditor/eqneditor.js"></script>*@


    <script>
        $(document).on("change", "#ExameCourseId", function () {
            $("#category-dropDown").addClass("disable-content");
            var request = createRequest();
            request.url = base_admin_url + "/crm/ExameCourseCategory/CategoryDropDown";
            request.type = "Get";
            request.data = { Id: $(this).val() };
            request.contentType = "html";
            request.success = function (result) {
                $("#category-dropDown").html(result);
                $("#category-dropDown").removeClass("disable-content");

            };
            $.ajax(request);
        });
    </script>
}