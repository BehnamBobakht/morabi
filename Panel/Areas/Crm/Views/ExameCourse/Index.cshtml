@model IEnumerable<DataLayer.Entities.ExameCourse>
@using DataLayer.Base;
@{
    ViewBag.Title = "دروس آزمون";
    Layout = "~/Views/Shared/Layout.cshtml";
}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    <script type="text/javascript">
        TableManageButtons.init();
    </script>
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th class="first">#</th>
                        <th>@Resource.Lang.Name</th>
                        
                        <th>نمره قبولی</th>
                        <th>@Resource.Lang.Type</th>
                        <th>@Resource.Lang.Status</th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ID)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.PassNumber)</td>

                        <td>@Html.DisplayFor(modelItem => item.Code.Name)</td>

                        <td>
                            @if (item.Active == true || item.Active == null)
                            {<span>فعال</span> }
                            else
                            {<span>غیر فعال</span>}
                        </td>


                        <td>
                            @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                            @Html.ActionLink(Resource.Lang.Delete, "Delete", new { id = item.ID }) |

                            @Html.ActionLink(Resource.Lang.Category, "index", new { @controller = "ExameCourseCategory", id = item.ID }) |

                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
