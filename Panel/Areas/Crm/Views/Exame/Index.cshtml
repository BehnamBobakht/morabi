@model IEnumerable<DataLayer.Entities.Exame>
@using DataLayer.Base;
@{
    ViewBag.Title = "آزمون ها";
    Layout = "~/Views/Shared/Layout.cshtml";
}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    <script type="text/javascript">
        TableManageButtons.init();
    </script>
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th class="first">#</th>
                        <th>@Resource.Lang.Name</th>
                        <th>@Resource.Lang.ProductName</th>
                        <th>@Resource.Lang.Date</th>
                        <th>@Resource.Lang.Time</th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ID)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                        <td>@item.StartDate.ToPersian()</td>
                        <td>@item.Time دقیقه</td>

                        <td>
                            @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                            @Html.ActionLink(Resource.Lang.Details, "Details", new { id = item.ID }) |

                            @Html.ActionLink(Resource.Lang.Delete, "Delete", new { id = item.ID }) |

                            @Html.ActionLink(Resource.Lang.Questions, "index", new { @controller = "ExameQuestion", id = item.ID }) |
                            @Html.ActionLink("شرکت کنندگان", "Users", new { exameId = item.ID }) |
                            @Html.ActionLink("کپی آزمون", "Copy", new { exameId = item.ID }) |

                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
