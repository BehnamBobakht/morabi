@model IEnumerable<DataLayer.Entities.ExameAccountAnswer>
@using DataLayer.Base;
@{
    ViewBag.Title = "شرکت کنندگان";
    Layout = "~/Views/Shared/Layout.cshtml";
    string index = ViewBag.PageIndex;
    string pageSize = ViewBag.PageSize;
    int TotalCount = ViewBag.TotalCount;
    int CurrentIndex = index.IsInteger() ? index.GetInteger() : 1;
    int PageSize = pageSize.IsInteger() ? pageSize.GetInteger() : 10;
    int StartIndex = CurrentIndex > 4 ? CurrentIndex - 4 : 1;
    int EndIndex = (TotalCount / PageSize);
    int Mod = (TotalCount % PageSize);
    EndIndex = Mod > 0 ? EndIndex + 1 : EndIndex;
    string Name = ViewBag.Name;
    int ExameId = ViewBag.ExameId;
    bool? IsPass = ViewBag.IsPass;

}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    @*<script type="text/javascript">
            TableManageButtons.init();
        </script>*@
}
<div>
    <form method="get" id="account-form" action="~/crm/Exame/Users">
        <div class="list_search row card-box m-0">
            <input type="hidden" id="exameId" name="exameId" value="@ViewBag.ExameId" />
            <div class="form-group mb-0 col-md-3">
                <label for="orderid" class="control-labe">فیلتر</label>
                <select id="IsPass" name="IsPass" class="form-control">
                    <option value="null">همه</option>
                    <option value="true" @(IsPass == true ? "selected" : "")>قبولی</option>
                </select>
            </div>
            <div class="form-group mb-0 col-md-3">
                <label for="orderid" class="control-labe">نام کاربر</label>
                <input type="text" class="form-control" name="name" value="@Name" />
            </div>
            <div class="form-group mb-0 col-md-2">
                <input type="submit" class="btn btn-success col-xs-12" value=@Resource.Lang.Search>
            </div>
            <div class="form-group mb-0 col-md-2">
                <div class="btn btn-primary">
                    @Html.ActionLink("چاپ کارنامه", "PrintReport", new { exameId = ViewBag.ExameId, IsPass = ViewBag.IsPass })
                </div>
            </div>
            <div class="form-group mb-0 col-md-2">
                <div class="btn btn-primary">
                    @Html.ActionLink("خروجی اکسل", "ExelExport", new { exameId = ViewBag.ExameId, IsPass = ViewBag.IsPass })
                </div>
            </div>
            <div class="form-group mb-0 col-md-2">
                <div class="btn btn-primary">
                    <a href="/Panel/crm/Exame/FinishExame1/@ViewBag.ExameId" target="_blank">اتمام آزمون</a>
                </div>
            </div>
            <div class="form-group mb-0 col-md-2">
                <div class="btn btn-primary">
                    <a href="/Panel/crm/Exame/FinishExame2/@ViewBag.ExameId" target="_blank">ثبت پاسخ ها</a>
                </div>
            </div>
            <div class="form-group mb-0 col-md-3">
                <div class="btn btn-danger">
                    @Html.ActionLink("حذف کل پاسخ های این آزمون", "DeleteExameAnswerAll2", new { Id = ViewBag.ExameId })
                </div>
            </div>
			
        </div>
    </form>
	
    <div class="col-sm-12">
        <div class="card-box table-responsive">
		<p>تعداد کل :@ViewBag.TotalCount</p>
            <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>

            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th class="first">#</th>
                        <th>نام آزمون</th>
                        <th>@Resource.Lang.FullName</th>
                        <th>نمره</th>
                        <th>@Resource.Lang.Status</th>
                     


                        <th>@Resource.Lang.Edit</th>



                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                       
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ID)</td>
                            <td>@Html.DisplayFor(modelItem => item.Exame.Name)</td>
                            <td>@item.Account.FullName @item.Account.LatName </td>
                            <td>
                                @{double? sum = (double)item.ExameReportByCourse.Sum(s => s.TotalRate) / item.ExameReportByCourse.Count();}
                                <span>@Math.Round(sum.Value, 1).ToString().Replace("/", ".")</span>
                            </td>
                            <td>
                                @if (sum >= item.Exame.PassValue)
                                {
                                    <strong>قبول</strong>
                                }
                                else
                                {
                                    <strong>مردود</strong>
                                }
                            </td>
                            
                            <td>
                                @Html.ActionLink("ویرایش", "ExameReportByCourse", new { Id = item.ID }) |
                                @Html.ActionLink("حذف", "DeleteExameReportByCourse", new { Id = item.ID }) |
                                @Html.ActionLink("پاسخنامه", "AnswerUser", new { Id = item.ID }) |
                                @Html.ActionLink("ثبت پاسخ ها", "FinishExame3", new { Id = ViewBag.ExameId, accountId=item.AccountId }) |
                                  @Html.ActionLink("چاپ کارنامه", "PrintReport", new { exameId = ViewBag.ExameId, IsPass = ViewBag.IsPass ,userId= item.AccountId })|

                                @Html.ActionLink("تاریخچه پرداخت ها", "index", new { @controller = "PaymentExame", accountId = item.AccountId }) |


                            </td>

                        </tr>
                    }
                </tbody>
            </table>
            <div class="dataTables_paginate paging_simple_numbers" id="datatable-buttons_paginate">


                <ul class="pagination">
                    <li class="paginate_button previous" aria-controls="datatable-buttons">
                        <a href="@Url.Action("users", new {
                             @name = Name,
							  @exameId=ExameId,
                                      @isPass = IsPass,
                            @pageIndex = 1,
                            @pageSize = pageSize

                        })">@Resource.Lang.FirstPage</a>
                    </li>
                    @for (int i = StartIndex; i <= EndIndex && i <= CurrentIndex + 4; i++)
                    {
                        var active = CurrentIndex == i ? "active" : "";
                        <li class="paginate_button @active" aria-controls="datatable-buttons">
                            <a href="@Url.Action("users", new {
                                     @name = Name,
									  @exameId=ExameId,
                                      @isPass = IsPass,
                                    @pageIndex = i,
                                    @pageSize = pageSize
                            })">@(i.ToPersian())</a>
                        </li>
                    }
                    @if (CurrentIndex < EndIndex)
                    {
                        <li class="paginate_button previous" aria-controls="datatable-buttons">
                            <a href="@Url.Action("users", new
                                    {

                                     @name = Name,
									 @exameId=ExameId,
                                      @isPass = IsPass,
                                    @pageIndex = EndIndex,
                                    @pageSize = pageSize
                            })">@Resource.Lang.LastPage</a>
                        </li>
                    }
                    else
                    {
                        <li class="paginate_button previous disabled" aria-controls="datatable-buttons">
                            <a href="#">@Resource.Lang.LastPage</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <!-- end col -->
</div>
