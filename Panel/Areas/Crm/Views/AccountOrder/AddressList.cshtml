@using DataLayer.Base;
@using DataLayer.ViewModels;
@model List<ViewAccountOrder>

@{
    ViewBag.Title = Resource.Lang.LettrerList;
    Layout = "~/Views/Shared/PrintLayout.cshtml";
    int sumCount = 0;
	string product = ViewBag.Product;
}

<div class="col-sm-12">
    <div class="text-left font-bold">
        @Resource.Lang.Date_TimePrint: @DateTime.Now.ToPersianWithTime().ToPersian()
    </div>
    <div class="devider-15"></div>
    @*<table class="table-middle table-print table table-striped table-bordered has-first dataTable">
        <thead>
            <tr>
                <th>#</th>
                <th>@Resource.Lang.OrderNumber</th>
                <th>@Resource.Lang.Receiver</th>
                <th>@Resource.Lang.Address</th>
                <th>@Resource.Lang.HowToSend</th>
            </tr>
        </thead>
        <tbody>*@
    @for (int i = 0; i < Model.Count(); i++)
    {
        var order = Model[i];
        //sumCount = sumCount + 1;
        if (order.AccountAddress != null && (order.AccountOrderProducts.Any(s=>s.Product.ProductType.Id== "3")||order.AccountOrderProducts.Any(s=>s.Product.ProductType.Id== "1")))
        {
            <div class="col-sm-12">
                <div class="form-horizontal line-height-invoice">
                    <div style="max-width:700px; margin: 0 auto;min-height:300px">
                        <h4>
                            <span style="width: 100%; text-align: right; display: inline-block">
                                <span>@Resource.Lang.Sender: @BaseContent.WebsiteDetail.Title &nbsp;&nbsp;&nbsp;</span>

                                <span>شماره تماس: @BaseContent.WebsiteDetail.Phone</span>
                                <br />

                                <span>آدرس: @BaseContent.WebsiteDetail.Address</span>

                            </span>
                            <br /><br />
                            <span style="width: 100%; text-align: right; display: inline-block">
                                <span>@Resource.Lang.Receiver: @order.AccountAddress.NameFamily &nbsp;&nbsp;&nbsp;</span>
                                <span>@Resource.Lang.Phone: @order.AccountAddress.Phone &nbsp; @order.Account.Mobile &nbsp;&nbsp;&nbsp;</span>
                                <span> @Resource.Lang.PostalCode: @order.AccountAddress.PostalCode</span>
                                <br />
                                <span> @Resource.Lang.Address:</span>

                                @if (order.AccountAddress.State != null)
                                {
                                    <span>@order.AccountAddress.State.Name - </span>
                                }
                                @if (order.AccountAddress.City != null)
                                {
                                    <span>@order.AccountAddress.City.Name - </span>
                                }
                                @order.AccountAddress.AddressValue<br />
                                <br />
                                <span>توضیحات :</span><span>@order.Description</span>
                                <br />
                                <span>محصولات: </span>
                                @foreach (var item in order.AccountOrderProducts.Where(s=>s.Product.ProductType.Id== "3"))
                                {
                                    <span>@item.Product.Name  | تعداد :@item.Count -  </span>
                                }
                            </span>
                        </h4>
                    </div>
                </div>
            </div>
            <hr />
            @*<tr>
                    <td>@((i + 1).ToString().ToPersian())</td>
                    <td>@order.UniqueId</td>
                    <td>
                        @if (order.AccountAddress != null)
                        {
                            <span>@order.AccountAddress.NameFamily </span>
                        }
                    </td>
                    <td>
                        @if (order.AccountAddress.State != null && order.AccountAddress.City != null)
                        {
                            <text>@order.AccountAddress.State.Name @order.AccountAddress.City.Name </text>
                        }
                        @order.AccountAddress.AddressValue

                    </td>
                    <td>@(order.SendType?.Name)</td>
                </tr>*@
        }
    }

    @*</tbody>
        </table>*@
</div>
<div>
    <a target="_blank" class="btn btn-primary"
       href="@Url.Action("changeStatusAll", new {
                                    @status = 2068,
                                    @product = product
                                })">تغییر   وضعیت پرداخت شده به ارسال شده</a>
</div>


