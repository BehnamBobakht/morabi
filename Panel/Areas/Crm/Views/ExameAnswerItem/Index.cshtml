@model IEnumerable<DataLayer.Entities.ExameAnswerItem>
@using DataLayer.Base;
@using DataLayer.Entities;

@{
    ExameQuestion exame = ViewBag.ExameQuestion;
    ViewBag.Title = "پاسخ ها  " + exame.Text.GetSubString(100);
    Layout = "~/Views/Shared/Layout.cshtml";
}
@section Footer {
    @Html.Action("TableScript", "Layout", new { area = "" })
}
@section Script {
    <script type="text/javascript">
        TableManageButtons.init();
    </script>
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create",new { id=exame.ID})" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <a href="@Url.Action("index",new {@controller = "ExameQuestion", id=exame.ExameId})" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.Back></a>

            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>
                        <th class="first">#</th>
                        <th>@Resource.Lang.Answer</th>
                        <th>سوال</th>

                        <th>@Resource.Lang.Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ToList())
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ID)</td>
                            <td>@item.Text.GetSubString(100)</td>
                            <td>@Html.DisplayFor(modelItem => item.ExameQuestion.Text)</td>
                            <td>
                                @if (item.Active == true || item.Active==null)
                                {<span>فعال</span> }
                                else
                                {<span>غیر فعال</span>}
                            </td>
                            <td>
                                @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                                @Html.ActionLink(Resource.Lang.Delete, "Delete", new { id = item.ID })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
