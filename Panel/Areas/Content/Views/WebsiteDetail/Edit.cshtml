}

@section Script {
    <script src="~/assets/plugins/tinymce/tinymce.min.js"></script>
    <script>
        function updatePrice() {
            var price = $("#EuroPrice").val();
            window.location.href = "/panel/store/product/UpdateEuroPrice?price=" + price;

        }
    </script>
}
