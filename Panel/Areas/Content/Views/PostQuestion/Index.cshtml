@using DataLayer.Base
@using DataLayer.Entities
@using DataLayer.ViewModels
@model List<PostQuestion>
@{
    var post = (PostVm)ViewBag.post;
    ViewBag.Title = post.Name + " " + Resource.Lang.Questions;
    Layout = "~/Views/Shared/Layout.cshtml";

}
@section Footer {
    @*@Html.Action("TableScript", "Layout", new { area = "" })*@
}
@section Script {
    @*<script type="text/javascript">
            TableManageButtons.init();
        </script>*@
}
<div>
    <div class="col-sm-12">
        <div class="card-box table-responsive">
            <a href="@Url.Action("create", new { id = post.ID })" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.AddNewCase></a>
            <table id="datatable-buttons" class="table table-striped table-bordered has-first">
                <thead>
                    <tr>

                        <th>#</th>
                        <th>@Resource.Lang.Question</th>
                        <th>@Resource.Lang.Answer</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count(); i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>@(i+1)</td>
                            <td>@item.QuestionText</td>
                            <td>@item.AnswerText</td>
                            <td>
                                @Html.ActionLink(Resource.Lang.Edit, "edit", new { id = item.ID }) |
                                @Html.ActionLink(Resource.Lang.Delete, "delete", new { id = item.ID })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end col -->
</div>
