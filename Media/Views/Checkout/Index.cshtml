@model Media.Models.QuickCheckoutViewModel
@{ViewBag.Title="خرید سریع "+Model.ProductTitle;}
<section class="container checkout-page"><div class="checkout-card"><img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)?Url.Content("~/Assets/images/img1.png"):Url.Content(Model.ImageUrl))" alt="@Model.ProductTitle"/><div class="checkout-copy"><span class="section-eyebrow">خرید سریع دوره</span><h1>@Model.ProductTitle</h1><p>پس از تأیید سفارش و پرداخت موفق، همه ویدئوها و PDFهای دوره فوراً برای شما فعال می‌شود.</p><strong class="checkout-price">@Model.Price.ToString("N0") تومان</strong>@if(!string.IsNullOrWhiteSpace(Model.Error)){<div class="auth-error">@Model.Error</div><a class="checkout-cart-link" href="/cart">مشاهده سبد خرید / تکمیل اطلاعات</a>}@using(Html.BeginForm("Buy","Checkout",new{id=Model.ProductId},FormMethod.Post,null)){@Html.AntiForgeryToken()<button type="submit" class="auth-submit">ادامه و پرداخت امن</button>}<a class="checkout-back" href="@Url.Action("Index","Learning")">بازگشت به دوره‌ها</a></div></div></section>