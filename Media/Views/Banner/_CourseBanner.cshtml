@model List<DataLayer.Entities.Banner>
@using DataLayer.Base
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <section class="container courses-hero">
            <img class="hero-banner-image" src="@item.Picture.GetUrl()" alt="" aria-hidden="true" />
            <div class="hero-copy">
                <span class="eyebrow">@item.Url</span>
                <h1>@item.Name</h1>
                <p>@item.Summary</p>
            </div>
            <div class="hero-play" aria-hidden="true"><span class="play-icon"></span><span class="play-line"></span></div>
        </section>
        

    }

}
