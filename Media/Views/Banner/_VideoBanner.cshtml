@model List<DataLayer.Entities.Banner>
@using DataLayer.Base
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <section class="my-videos-hero video-banner-desktop">
            <img class="hero-banner-image" src="@item.Picture.GetUrl()" alt="" aria-hidden="true" />
            <div class="container my-videos-hero-inner">
                <h1>@item.Name</h1>
                <p>@item.Summary</p>
            </div>
        </section>
        
    }

}
