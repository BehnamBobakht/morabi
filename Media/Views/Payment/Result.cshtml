@model Media.Models.MediaPaymentResultViewModel
@{ViewBag.Title=Model.Success?"پرداخت موفق":"نتیجه پرداخت";}
<section class="container payment-result-page"><div class="payment-result-card @(Model.Success?"success":"failed")"><div class="payment-result-icon">@(Model.Success?"✓":"!")</div><h1>@(Model.Success?"پرداخت موفق":"پرداخت ناموفق")</h1><p>@Model.Message</p>@if(!string.IsNullOrWhiteSpace(Model.ReferenceNumber)){<div class="tracking-code"><span>کد رهگیری</span><strong>@Model.ReferenceNumber</strong></div>}@if(Model.Success&&Model.ProductId.HasValue){<a class="auth-submit payment-watch-button" href="@Url.Action("Watch","Courses",new{id=Model.ProductId.Value})">مشاهده ویدئوهای @Model.ProductTitle</a>}else{<a class="auth-submit payment-watch-button" href="@Url.Action("Index","Learning")">بازگشت به دوره‌ها</a>}</div></section>