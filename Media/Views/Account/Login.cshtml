@model DataLayer.Entities.Account
@{ ViewBag.Title="ورود"; var back=ViewBag.Back as string ?? "/learning"; }
<section class="auth-page container"><div class="auth-card"><div class="auth-brand"><span>ورود به رسانه مربی ایران</span><h1>خوش آمدید</h1><p>برای تماشای ویدئوهای دمو و محتوای دوره وارد حساب خود شوید.</p></div>@using(Html.BeginForm("Login", "Account", FormMethod.Post, null)){ @Html.AntiForgeryToken()<input type="hidden" name="back" value="@back" />if(ViewBag.Error!=null){<div class="auth-error">@ViewBag.Error</div>}<label>شماره موبایل یا ایمیل</label>@Html.TextBoxFor(x=>x.Mobile,new{@class="auth-input",autocomplete="username",placeholder="شماره موبایل یا ایمیل"})<label>رمز عبور</label>@Html.PasswordFor(x=>x.Password,new{@class="auth-input",autocomplete="current-password",placeholder="رمز عبور"})<div class="auth-options"><label class="auth-remember"><input type="checkbox" name="remember" value="true" checked /> مرا به خاطر بسپار</label><a class="auth-forgot" href="@Url.RouteUrl("MediaForget")">رمز عبور را فراموش کرده‌اید؟</a></div><button class="auth-submit" type="submit">ورود به حساب</button>}<p class="auth-switch">حساب ندارید؟ <a href="@Url.Action("Register",new{back=back})">ثبت‌نام کنید</a></p></div></section>
