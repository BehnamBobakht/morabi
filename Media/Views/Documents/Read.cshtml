@using System.Web
@model Media.Models.CourseDocumentReadViewModel

@{
    ViewBag.Title = Model.Document.Title;

    var pdfUrl = Url.Action(
        "Pdf",
        "Documents",
        new { id = Model.Document.ID }
    );
}

<section class="container pdf-read-page"
         data-protected-media="true"
         oncontextmenu="return false;"
         ondragstart="return false;">

    <nav class="breadcrumbs">
        <a href="@Url.Action("Index", "Learning")">دوره‌ها</a>
        <span>/</span>
        <a href="@Url.Action("Index", new { id = Model.ProductId })">PDFهای دوره</a>
        <span>/</span>
        <span>@Model.Document.Title</span>
    </nav>

    <header class="pdf-read-heading">
        <div>
            <span class="lesson-kicker">در حال مطالعه</span>
            <h1>@Model.Document.Title</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Document.Description))
            {
                <p>@Model.Document.Description</p>
            }
        </div>

        <span class="viewed-label">مشاهده‌شده</span>
    </header>

    <div class="pdf-reader-layout">
        <details class="course-pdf-list" open>
            <summary>
                <span>فهرست فایل‌های PDF دوره</span>
                <a class="course-back-link" href="@Url.Action("Index", "Learning")" onclick="event.stopPropagation();">بازگشت به دوره</a>
            </summary>
            <nav>
                @foreach (var item in Model.Documents)
                {
                    <a class="course-pdf-item @(item.ID == Model.Document.ID ? "active" : "")" href="@Url.Action("Read", "Documents", new { id = item.ID })">
                        <span>@item.Title</span>
                        @if (item.IsViewed)
                        {
                            <small>مشاهده‌شده</small>
                        }
                    </a>
                }
            </nav>
        </details>
        <div class="pdf-reader-custom">

        <div class="pdf-toolbar-custom">

            <button type="button" id="pdf-prev">
                صفحه قبل
            </button>
            <span>
                صفحه
                <b id="pdf-page-number">1</b>
                از
                <b id="pdf-page-count">...</b>
            </span>

            <label class="pdf-page-jump" for="pdf-page-input">
                <input id="pdf-page-input" type="number" min="1" value="1" inputmode="numeric" aria-label="شماره صفحه" />
                <button type="button" id="pdf-page-go">برو</button>
            </label>

            <button type="button" id="pdf-next">
                صفحه بعد
            </button>

        </div>

        <div class="pdf-frame-box">

            <div id="pdf-loading">در حال بارگذاری PDF...</div>
            <div id="pdf-error" hidden>نمایش PDF با خطا مواجه شد.</div>
            <iframe id="pdf-frame" data-pdf-url="@pdfUrl" title="صفحه PDF" scrolling="yes"></iframe>
            <div id="pdf-ios-viewer"
                 data-pdf-url="@pdfUrl"
                 data-pdf-module="@Url.Content("~/Assets/pdfjs/build/pdf.js")"
                 data-pdf-worker="@Url.Content("~/Assets/pdfjs/build/pdf.worker.js")"
                 data-pdf-cmaps="@Url.Content("~/Assets/pdfjs/web/cmaps/")"
                 data-pdf-fonts="@Url.Content("~/Assets/pdfjs/web/standard_fonts/")"
                 data-fallback-font="@Url.Content("~/Assets/fonts/YekanBakhFaNum-Regular.ttf")"
                 data-fallback-font-bold="@Url.Content("~/Assets/fonts/YekanBakhFaNum-Bold.ttf")"
                 hidden></div>
            <div class="pdf-protection-layer" aria-hidden="true"></div>

        </div>

    </div>
    </div>

</section>


<style>

    #pdf-ios-viewer { width:100%; min-width:0; background:#fff; overflow-x:hidden; }
    .pdf-ios-page { width:100%; min-width:0; margin:0 auto 12px; background:#fff; box-shadow:0 1px 5px rgba(0,0,0,.12); }
    .pdf-ios-page canvas { display:block; width:100%; height:auto; background:#fff; }
    .pdf-frame-box.ios-pdf-mode { overflow-x:hidden; overflow-y:auto; touch-action:pan-y; background:#fff; }
    .pdf-frame-box.ios-pdf-mode #pdf-frame { display:none; }
    .pdf-frame-box.ios-pdf-mode #pdf-ios-viewer { display:block; width:100%; max-width:100%; }
    .pdf-page-jump { display:flex; align-items:center; gap:5px; }
    .pdf-page-jump input { width:64px; height:36px; text-align:center; border:1px solid #ddd; border-radius:6px; }


    .pdf-reader-layout { display:grid; grid-template-columns:280px minmax(0,1fr); gap:20px; align-items:start; direction:rtl; }
    .course-pdf-list { margin-top:20px; border:1px solid #e5e5e5; border-radius:12px; background:#fff; overflow:hidden; }
    .course-pdf-list summary { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:15px 16px; font-weight:700; cursor:pointer; background:#f7f7f7; }
    .course-back-link { padding:7px 10px; border-radius:7px; background:#fff; border:1px solid #ddd; color:inherit; font-size:12px; text-decoration:none; white-space:nowrap; }
    .course-pdf-list nav { padding:8px; }
    .course-pdf-item { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px; border-radius:8px; color:inherit; text-decoration:none; }
    .course-pdf-item:hover { background:#f5f7fa; }
    .course-pdf-item.active { background:#eef5ff; color:#1559a6; font-weight:700; }
    .course-pdf-item small { white-space:nowrap; color:#17803d; font-size:11px; }

    .pdf-reader-custom {
        width: 100%;
        margin-top: 20px;
    }

    .pdf-toolbar-custom {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        background: #fff;
        border: 1px solid #e5e5e5;
        border-bottom: 0;
        position: relative;
        z-index: 2;
    }

        .pdf-toolbar-custom button {
            border: 1px solid #ddd;
            background: #fff;
            padding: 8px 16px;
            cursor: pointer;
        }

            .pdf-toolbar-custom button:disabled {
                opacity: .4;
                cursor: default;
            }
    .pdf-frame-box {
        width: 100%;
        min-height: 600px;
        border: 1px solid #e5e5e5;
        background: #fff;
        overflow: auto;
        padding: 16px;
        text-align: center;
    }

    #pdf-frame {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
        background: #fff;
    }
    .pdf-frame-box {
        position: relative;
        height: 82vh;
        max-height: 980px;
        padding: 0;
        overflow: hidden;
    }

    .pdf-protection-layer {
        position: absolute;
        inset: 0;
        z-index: 3;
        background: transparent;
        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
    }

    #pdf-loading, #pdf-error { padding: 40px 16px; color: #666; }
    #pdf-error { color: #b42318; }

    @@media (max-width: 768px) {

        .pdf-reader-layout { display:flex; flex-direction:column; gap:0; width:100%; min-width:0; }
        .course-pdf-list { width:100%; margin-top:14px; }
        .pdf-reader-custom { width:100%; min-width:0; }
    .pdf-frame-box {
            height: 72vh;
            min-height: 460px;
            padding: 0;
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior-x: none;
            touch-action: pan-y;
        }

        .pdf-protection-layer {
            display: none;
            pointer-events: none;
        }

        #pdf-frame {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-y;
        }


        .pdf-frame-box.ios-pdf-mode { overflow-x:hidden; overflow-y:auto; -webkit-overflow-scrolling:touch; touch-action:pan-y; background:#fff; }
        .pdf-frame-box.ios-pdf-mode #pdf-frame { display:none; }
        .pdf-frame-box.ios-pdf-mode #pdf-ios-viewer { display:block; width:100%; max-width:100%; }

        .pdf-reader-custom.ios-reader-mode .pdf-toolbar-custom {
            display: flex;
            position: sticky;
            top: 0;
            height: auto;
            min-height: 54px;
            padding: 8px;
            gap: 8px;
            flex-wrap: wrap;
        }

        .pdf-page-jump { display:flex; align-items:center; gap:5px; }
        .pdf-page-jump input { width:58px; height:36px; text-align:center; border:1px solid #ddd; border-radius:6px; }
        .pdf-toolbar-custom {
            display: none;
        }

            .pdf-toolbar-custom button {
                padding: 7px 10px;
                font-size: 13px;
            }
    }
</style>


@section scripts {
    <script src="@Url.Content("~/Assets/js/document-reader.js?v=20260831-7")"></script>
}