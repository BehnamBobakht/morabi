@using DataLayer.Base;
@model DataLayer.Entities.Delivery
@{
    ViewBag.Title = Resource.Lang.ActiveDeactive;
    Layout = Resources.Default.STORE_LAYOUT;
}
<div class="col-sm-12">
    <div class="card-box">
        <a href="@Url.Action("index")" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title=@Resource.Lang.Back></a>
        <div class="col-sm-12">
            @if (ViewBag.Alert != null)
            {
                <p class="alert alert-danger">@ViewBag.Alert</p>

            }
            <div class="form-horizontal">
                <h3>@Resource.Lang.AreYouSure</h3>
                <dl class="dl-horizontal">
                    <dt>
                        @Resource.Lang.Type
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.DeliveryType.Name)
                    </dd>

                </dl>
            </div>
            <div class="form-group">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                <div class="form-actions no-color">
                    <input type="submit" value=@(Model.Active? Resource.Lang.Deactive : Resource.Lang.Active) class="btn btn-danger" />
                    <span class="btn btn-inverse">@Html.ActionLink(Resource.Lang.Back, "Index")</span>
                </div>
                }
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>