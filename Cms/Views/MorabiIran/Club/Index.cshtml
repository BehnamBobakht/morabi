@using DataLayer.Entities;
@using DataLayer.Base;
@using DataLayer.Enumarables;
@using DataLayer.ViewModels

@model Clubs
@{
    Layout = "~/Views/" + BaseWebsite.WebsiteLabel + "/Shared/_Layout.cshtml";
    TempData["Title"] = "";
    if (Model.Code.Label == "FIELD_CLUB_TEACHERS")
    {
        TempData["Title"] = "سامانه مربیان";

    }
    else if (Model.Code.Label == "FIELD_CLUB_OWNER")
    {
        TempData["Title"] = "باشگاه داران";
    }
    else
    {
        TempData["Title"] = " سامانه ورزشکاران";
    }

    var breadcrumb = new List<BreadcrumbVm>();
    breadcrumb.Add(new BreadcrumbVm() { Title = TempData["Title"].ToString(), Url = "/club/search?typeId=" + Model.Code.Label });

    breadcrumb.Add(new BreadcrumbVm() { Title = Model.Name, Url = "" });


}
