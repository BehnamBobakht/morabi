@using DataLayer.Base
@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/assets/@BaseWebsite.WebsiteLabel/css/all.css" />
  
    <link rel="stylesheet" href="/assets/@BaseWebsite.WebsiteLabel/css/style.css" />
    <title>@Resource.Lang.Error</title>
</head>

<body>
    <section class="notfoundpage">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 text-center m-auto bg-light border rounded mt-5 p-3 shadow" >
                    <h2>404</h2>
                    <h3>@Resource.Lang.PageNotFound</h3>
                    <a href="/" class="btn btn-warning">@Resource.Lang.BackToHomePage</a>
                </div>
            </div>
        </div>
    </section>
    <script src="/assets/@BaseWebsite.WebsiteLabel/js/jquery.js"></script>
    <script src="/assets/@BaseWebsite.WebsiteLabel/js/bootstrap.bundle.min.js"></script>

    <script src="/assets/@BaseWebsite.WebsiteLabel/js/scripts.js"></script>
</body>

</html>


