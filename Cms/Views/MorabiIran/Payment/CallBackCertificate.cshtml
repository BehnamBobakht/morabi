@using DataLayer.ViewModels;
@using DataLayer.Base;
@using DataLayer.Enumarables;
@model ViewPay
@{
    ViewBag.Title = Resource.Lang.Payment;
    Layout = "~/Views/" + BaseWebsite.WebsiteLabel + "/Shared/_Layout.cshtml";
}
<section class="basket pagePadding">
    <div class="container">
        <div class="basket_box">
            <div class="row w-100 m-0">
                <div class="basket_tab w-100">
                    @Html.Partial("~/Views/" + BaseWebsite.WebsiteLabel + "/Cart/_CartHeader.cshtml", model: CartHeader.CallBack)
                    <div class="tab_content w-100 ">
                        <div class="message d-flex justify-content-between align-items-center">
                            @if (Model.Payment.Code.Label == Enum_Code.PAYMENT_STATUS_SUCCESSFUL.ToString())
                            {


                                <div class="bank-result">
                                    <div class="bank-result-ic">
                                        <i class="fr-check-circle"></i>
                                    </div>
                                    <div class="bank-result-title text-success">
                                        <div class="successIcon"></div>
                                        @*<h4>@Resource.Lang.SuccessfulPayment</h4><hr />*@
                                        @{
                                            string name = "";
                                            foreach (var item in Model.Names)
                                            {
                                                name = name + " - ";
                                            }
                                        }
                                        <h4 id="paymentSuccess">خرید موفق آمیز</h4><hr />
                                      <p>
     درخواست ارسال گواهی شما ثبت شد
     مرسوله شما ۳ الی ۷ روز کاری برای شما ارسال خواهد شد.
 </p>
 <p class="d-none">کانال کدرهگیری: <a href="https://t.me/coderahgiripost">https://t.me/coderahgiripost</a></p>

                                        <a href="/" class="btn back2home ">بازگشت به صفحه اصلی </a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="bank-result unsuccessful">
                                    <div class="bank-result-ic">
                                        <i class="fr-close"></i>
                                    </div>
                                    <div class="bank-result-title text-danger">
                                        <h4 id="paymentOnSuccess">@Resource.Lang.UnSuccessfulPayment</h4>
                                        <span>@Resource.Lang.YourPaymentEncounteredError</span>
                                        <br />
                                        <a href="@Url.Action("index", "basket")">
                                            <i class="fr-right"></i>
                                            <span>@Resource.Lang.BackToBasket</span>
                                        </a>
                                        <a href="/" class="btn btn-danger">@Resource.Lang.BackToHomePage</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


