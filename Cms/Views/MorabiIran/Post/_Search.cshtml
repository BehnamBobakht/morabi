    <div class="search_result ">
        <!--ko if:viewModel.PostSearchResult.Results()!=null && viewModel.PostSearchResult.Results().length!=0-->
        <div class="search_no_result" data-bind="visible: (viewModel.PostSearchResult.Results().Posts.length == 0 )">
            @Resource.Lang.NoResult
        </div>

        <div class="search_with_result" data-bind="visible: (viewModel.PostSearchResult.Results().Posts.length >0)">
            <ul>
                <!-- ko foreach:viewModel.PostSearchResult.Results().Posts -->
                <li class="textHover">
                    <a data-bind="attr: { 'href': Href }">
                        <strong data-bind="text: Name"></strong>
                    </a>
                </li>
                <!-- /ko -->
            </ul>
        </div>
        <!--/ko-->
    </div>
