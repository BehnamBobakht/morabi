@using DataLayer.Base
@using DataLayer.ViewModels

@model PostSearchVm


@foreach (var item in Model.Posts)
{
    <div class="col-lg-4 col-sm-6 p-1">
        <div class="home-media-item linkitem">
            <a href="@item.Href"></a>
            <div class="home-media-img">

                    <img src="@item.Picture.Url" alt="@item.Name">
                
            </div>
            <div class="home-media-caption central flex-column">
                <div class="home-media-btn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3ZM1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23C5.92487 23 1 18.0751 1 12ZM9.52811 7.11833C9.85327 6.94431 10.2478 6.96338 10.5547 7.16795L16.5547 11.1679C16.8329 11.3534 17 11.6656 17 12C17 12.3344 16.8329 12.6466 16.5547 12.832L10.5547 16.832C10.2478 17.0366 9.85327 17.0557 9.52811 16.8817C9.20295 16.7077 8.99997 16.3688 8.99997 16V8C8.99997 7.6312 9.20295 7.29234 9.52811 7.11833ZM11 9.86852V14.1315L14.1972 12L11 9.86852Z" fill="white" />
                    </svg>
                </div>
                <p>@item.Name</p>
            </div>
        </div>
    </div>



}

