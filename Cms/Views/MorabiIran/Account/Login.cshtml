        <div class="row section-padding">
            <div class="col-lg-8">
                <div class="loginRegister-textbox central h-100 d-none">
                    @Html.Action("Search", "Banner", new { bacategory = "LoginBanner1", baviewName = "_LoginText", baSize = 1 })
                </div>
            </div>
