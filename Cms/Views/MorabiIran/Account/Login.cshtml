                                            </svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="align justify-content-between flex-wrap">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" value="" name="remember" id="brand1">
                                        <label class="form-check-label" for="brand1">
                                            @Resource.Lang.RememberMe
                                        </label>
                                    </div>
                                    <a href="@Url.Action("Forget","Account",new {back= ViewBag.back})" class="recoverPass_btn">@Resource.Lang.RecoveryPassword</a>


                                </div>
                                <div class="loginFooter">
                                    <button class="btn login_btn" type="submit">
                                        @Resource.Lang.SignIn
                                    </button>
                                    <a href="@Url.Action("Register","Account",new {back= ViewBag.back})" class="btn">@Resource.Lang.SignUp</a>
                                </div>



                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

















