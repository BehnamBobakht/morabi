@using DataLayer.ViewModels
@model IEnumerable<HomeProductCardVm>

@foreach (var item in Model)
{
    <article class="course-card">
        <a href="@item.ProductUrl" aria-label="مشاهده @item.Name">
            <div class="course-media">
                <img src="@item.ImageUrl" alt="@item.Name" width="480" height="600" loading="lazy" decoding="async" fetchpriority="low" />
                @if (item.HasDiscount)
                {
                    <span class="discount-badge">@item.DiscountPercent٪</span>
                }
            </div>
            <div class="course-body">
                <small>@(String.IsNullOrWhiteSpace(item.CategoryName) ? "دوره تخصصی" : item.CategoryName)</small>
                <h3>@item.Name</h3>
                <div class="course-price">
                    @if (item.HasDiscount)
                    {
                        <del>@item.BasePrice.ToString("n0") تومان</del>
                    }
                    <b>@item.CurrentPrice.ToString("n0") تومان</b>
                </div>
                <button type="button" aria-label="افزودن دوره به سبد خرید">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4.5h2l2.1 9.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 1.9-1.5l1.4-6.5H6.2"/><circle cx="9.5" cy="19.5" r="1.25"/><circle cx="17.5" cy="19.5" r="1.25"/></svg>
                </button>
            </div>
        </a>
    </article>
}
