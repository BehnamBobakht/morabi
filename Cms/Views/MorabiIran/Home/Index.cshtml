@using System.Web.Mvc.Html;
@using DataLayer.Base;
@using DataLayer.Enumarables;
@{
    Layout = "~/Views/" + BaseWebsite.WebsiteLabel + "/Shared/_LayoutIndex.cshtml";
    ViewBag.isHomePage = true;
    ViewBag.PageName = "home";
}
@section MetaTag{
    @Html.Partial("~/Views/Default/Seo/Home_Index.cshtml")
}
@section Head{
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.0.3/dist/leaflet.css" />
    <link href="/Assets/@BaseWebsite.WebsiteLabel/Map/style.css" rel="stylesheet" />
    <link href="/Assets/@BaseWebsite.WebsiteLabel/Map/MarkerCluster.css" rel="stylesheet" />
    <link href="/Assets/@BaseWebsite.WebsiteLabel/Map/MarkerCluster.Default.css" rel="stylesheet" />

}
@section endScripts{
    <script src="https://unpkg.com/leaflet@1.0.3/dist/leaflet.js"></script>
    <script src="/Assets/@BaseWebsite.WebsiteLabel/Map/search.js"></script>
    <script src="/Assets/@BaseWebsite.WebsiteLabel/Map/show.js"></script>
    <script src="/Assets/@BaseWebsite.WebsiteLabel/Map/leaflet.markercluster-src.js"></script>
    <script>
        initialProductsInfinity()
    </script>
}
<div class="background-box">
    <img src="/assets/@BaseWebsite.WebsiteLabel/images/slider-back.png" alt="">
</div>
<main>
    @Html.Action("Search", "Banner", new { bacategory = "PopUpbanner", baSize = 1, baviewName = "_PopUpbanner" })
    @Html.Action("Search", "Slider", new { slviewname = "MainSlider" })
    <section class="home-reports">
        <div class="container">
            <div class="row central">
                <div class="col-lg-2 col-md-3 col-sm-4 col-6 p-1 central">
                    <div class="home-report-item report1 central flex-column">

                        <span>@ViewBag.CountVisit.ToString("n0")</span>
                        <p>بازدید کنندگان از سایت</p>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-4 col-6 p-1 central">
                    <div class="home-report-item report2 central flex-column">

                        <span>@ViewBag.CountRegCourse.ToString("n0")</span>
                        <p>شرکت کنندگان در دوره</p>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-4 col-6 p-1 central">
                    <div class="home-report-item report3 central flex-column">

                        <span>@ViewBag.CountQuiz.ToString("n0")</span>
                        <p>شرکت کنندگان در آزمون</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    @Html.Action("Search", "Banner", new { bacategory = "HomeAboutUs", baSize = 1, baviewName = "_HomeAboutUs" })


    <section class="home-tests page-padding">
        <div class="container">
            <div class="section-title position-relative align">
                <h1>برگزاری دوره های تست مربیگری در کل کشور</h1>
            </div>
            <div class="home-tests-map map-contaner">
                <span class="loc-init" contaner="contactmap" lat="35.70080152485188" lng="51.39472961425781" zoom="6" search="true" h="500" w=""></span>
                @Html.Action("SearchPartial", "Product", new { prstock = true, hasExpire = false, prpagesize = 200, isService = true, prviewname = "ServicesList", prorder = DataLayer.Enumarables.Enum_ProductOrder.NEW, isLat = true })
                <div id='contactmap' class='contactmap map' style=""></div>
            </div>
        </div>
    </section>
    <section class="home-courses page-padding">
        <div class="container">
            <div class="section-title position-relative align">
                <h1>دوره‌های در‌حال برگزاری</h1>
            </div>
            @if (Request.Browser.IsMobileDevice)
            {
                <div id="search-page-form" class="row">
                    <div class="infinity-div">
                        <div class="poducts_box row m-0" id="infinity-content" page-index="1" page-view="ProductItemSellList" loading="false">


                        </div>
                        <div class="spinner">
                            <div class="rect1"></div>
                            <div class="rect2"></div>
                            <div class="rect3"></div>
                            <div class="rect4"></div>
                            <div class="rect5"></div>
                        </div>

                    </div>

                </div>
            }
            else
            {
                <div dir="rtl" class="swiper slider2">
                    <div class="swiper-wrapper">

                        @Html.Action("SearchPartial", "Product", new { prstock = true, hasExpire = false, prpagesize = 12, prviewname = "CourseItemList", prorder = DataLayer.Enumarables.Enum_ProductOrder.NEW, typeId = 2 })

                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-pagination"></div>
                </div>
            }

        </div>
    </section>
    <section class="home-products page-padding">
        <div class="container">
            <div class="section-title position-relative align">
                <h1>کتاب های پرفروش</h1>
                <a href="/search/books?prorder=@DataLayer.Enumarables.Enum_ProductOrder.MORE_SELL">مشاهده همه</a>
            </div>
            <div dir="rtl" class="swiper slider6">
                <div class="swiper-wrapper">
                    @Html.Action("SearchPartial", "Product", new { prstock = true, prpagesize = 12, prviewname = "ProductItemList", prorder = DataLayer.Enumarables.Enum_ProductOrder.MORE_SELL, prcustomlabel = "books" })


                </div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </section>
    <section class="home-calculator section-padding">
        <div class="container">
            <ul class="nav nav-tabs" id="home-calculator-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link central active" id="home-cat1-tab" data-bs-toggle="tab" href="#home-cat1"
                       role="tab" aria-controls="home-cat1" aria-selected="true">محاسبه BMI</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link central" id="home-cat2-tab" data-bs-toggle="tab" href="#home-cat2"
                       role="tab" aria-controls="home-cat2" aria-selected="false">محاسبه درصد چربی</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link central" id="home-cat3-tab" data-bs-toggle="tab" href="#home-cat3"
                       role="tab" aria-controls="home-cat3" aria-selected="false">تعیین کالری روزانه</a>
                </li>
            </ul>
            <div class="tab-content" id="home-calculator-content">
                <div class="tab-pane fade show active" id="home-cat1" role="tabpanel" aria-labelledby="home-cat1-tab">
                    <div class="row">
                        @Html.Action("Search", "Banner", new { bacategory = "BMIBanner", baSize = 1, baviewName = "_BMIBanner" })
                        <div class="col-lg-1 p-0"></div>
                        <div class="col-lg-3 p-0">
                            <div class="home-calculator-form">
                                <div id="formMBI">
                                    <div class="home-calculator-form-item align mb-3">
                                        <label for="">قد (سانتی متر)</label>
                                        <input class="form-control me-3" id="Height" type="number" min="1">
                                    </div>
                                    <div class="home-calculator-form-item align mb-3">
                                        <label for="">وزن (کیلوگرم)</label>
                                        <input class="form-control me-3" id="Weight" type="number" min="1">
                                    </div>
                                    <div class="home-calculator-form-item align mb-3">
                                        <label for="">سن</label>
                                        <input class="form-control me-3" id="Age" type="number" min="1">
                                    </div>
                                    <div class="home-calculator-form-item align mb-3">
                                        <input class="ms-3" type="radio" value="0" name="Gender">
                                        <label for="">خانوم</label>
                                    </div>
                                    <div class="home-calculator-form-item align mb-3">
                                        <input class="ms-3" type="radio" value="1" name="Gender">
                                        <label for="">آقا</label>
                                    </div>
                                    <button onclick="checkBMI();" class="btn secondary-btn w-100 py-2">محاسبه</button>
                                </div>
                            </div>
                            <div class="home-calculator-result h-100 align flex-column justify-content-around d-none" id="divRes1">
                                <strong>نتیجه BMI شما :</strong>
                                <strong id="BMI"></strong>
                                <ul>
                                    <li>BMI کمتر از ۱۸/۵ : کمبود وزن</li>
                                    <li>BMI بین ۱۸/۵ تا ۲۴/۵ : وزن سلامت</li>
                                    <li>BMI بین ۲۵ تا ۲۹/۹ : اضافه وزن</li>
                                    <li>BMI بیشتر از ۳۰ : چاقی</li>
                                </ul>
                                <p></p>

                                <button onclick="refreshBMI();" class="btn secondary-btn w-100 py-2 mt-4">محاسبه مجدد</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="home-cat2" role="tabpanel" aria-labelledby="home-cat2-tab">
                    <div class="row" id="divres2">
                        <div class="col-lg-4 p-0">
                            <div class="home-calculator-img central">
                                <figure class="highcharts-figure">
                                    <div id="container"></div>
                                </figure>
                            </div>
                        </div>
                        <div class="col-lg-1 p-0"></div>
                        <div class="col-lg-3 p-0 my-3 my-lg-0">
                            <div class="home-calculator-text h-100 justify flex-column">
                                <h1>شاخص توده بدنی چیست؟</h1>
                                <p>
                                    (Body Mass Index = BMI) نشان دهنده میزان چربی بدن است. افراد با دانستن بی ام آی بدنشان می توانند ذهنیتی نسبی از وضعیت جسمی شان بدست آوردند و در صورت نیاز به درمان و حفظ سلامتی تصمیم بگیرند.
                                    شاخص حجم بدن (BMI) فرمولی است که توسط آماردان بلژیکی ساخته و توسط آدولف کتلت توسعه یافت.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-1 p-0"></div>
                        <div class="col-lg-3 p-0">
                            <div class="home-calculator-result h-100 align flex-column justify-content-around">
                                <p>درصد چربی شما : </p>
                                <span id="CH"></span>
                                <a href="#" class="btn secondary-btn w-100 py-2">محاسبه مجدد</a>
                            </div>
                        </div>
                        @*<strong>درصد چربی شما : </strong>
                            <strong id="CH"></strong>*@
                    </div>
                </div>
                <div class="tab-pane fade" id="home-cat3" role="tabpanel" aria-labelledby="home-cat3-tab">
                    <div class="row" id="divRes3">
                        <strong>میزان کالری روزانه به طور کلی: </strong>
                        <strong id="Bmr"></strong>
                        <strong>میزان کالری برای فعالیت خیلی سبک: </strong>
                        <strong id="Bmr1"></strong>
                        <strong>میزان کالری برای فعالیت سبک: </strong>
                        <strong id="Bmr2"></strong>
                        <strong>میزان کالری برای فعالیت متوسط: </strong>
                        <strong id="Bmr3"></strong>
                        <strong>میزان کالری برای فعالیت سنگین: </strong>
                        <strong id="Bmr4"></strong>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="home-media section-padding">
        <div class="container">
            <div class="section-title position-relative align">
                <h1>ویدئو های منتخب</h1>
                <a href="@Url.Action("page","post",new { pocategory="Video",poorder = Enum_PostOrder.SHOWNUMBER},Request.Url.Scheme)">مشاهده همه</a>
            </div>
            <div class="row">
                @Html.Action("Search", "post", new { pocategory = "Video", poSize = 6, poviewName = "HomeVideo", poorder = Enum_PostOrder.SHOWNUMBER })
            </div>
        </div>
    </section>
    <section class="home-blog section-padding">
        <div class="container">
            <div class="section-title position-relative align">
                <ul class="nav nav-tabs" id="home-blog-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link central active" id="home-blog-tab" data-bs-toggle="tab" href="#home-blog"
                           role="tab" aria-controls="home-blog" aria-selected="true">@Resource.Lang.News</a>
                        <a href="@Url.Action("page","post",new { pocategory="news"},Request.Url.Scheme)">@Resource.Lang.SeeAll</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link central" id="home-news-tab" data-bs-toggle="tab" href="#home-news"
                           role="tab" aria-controls="home-news" aria-selected="false">@Resource.Lang.Articles</a>
                        <a href="@Url.Action("page","post",new { pocategory="blog"},Request.Url.Scheme)">@Resource.Lang.SeeAll</a>
                    </li>
                </ul>

            </div>
            <div class="tab-content" id="home-blog-content">
                <div class="tab-pane fade show active" id="home-blog" role="tabpanel" aria-labelledby="home-blog-tab">
                    <div dir="rtl" class="swiper slider3">
                        <div class="swiper-wrapper">
                            @Html.Action("Search", "post", new { pocategory = "news", poSize = 5, poviewName = "HomeNewNewsList", poorder = Enum_PostOrder.NEW })


                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="home-news" role="tabpanel" aria-labelledby="home-news-tab">
                    <div dir="rtl" class="swiper slider3">
                        <div class="swiper-wrapper">
                            @Html.Action("Search", "post", new { pocategory = "blog", poSize = 5, poviewName = "HomeNewNewsList", poorder = Enum_PostOrder.NEW })



                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
