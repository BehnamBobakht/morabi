@using System.Web.Mvc.Html;
@using DataLayer.Base;
@{
    Layout = "~/Views/" + BaseWebsite.WebsiteLabel + "/Shared/_LayoutIndex.cshtml";
    ViewBag.isHomePage = true;
    ViewBag.PageName = "home";
}
@section MetaTag{
    @Html.Partial("~/Views/Default/Seo/Home_Index.cshtml")
}
@section Head{
    <link rel="stylesheet" href="/assets/@BaseWebsite.WebsiteLabel/css/home-redesign.css?v=16" />
}
@Html.Partial("~/Views/" + BaseWebsite.WebsiteLabel + "/Home/_HomeRedesign.cshtml")
@Html.Action("Search", "Banner", new { bacategory = "PopUpbanner", baSize = 1, baviewName = "_PopUpbanner" })

@section endScripts {
    <script>
        window.addEventListener('load', function () {
            var popup = document.getElementById('popIndex');
            if (popup && window.jQuery && jQuery.fn.modal) {
                jQuery(popup).modal('show');
            }
        });
    </script>
}
