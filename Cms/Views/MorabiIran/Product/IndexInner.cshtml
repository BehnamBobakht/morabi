        <div class="product-invoice">

            @if (isAvailable && Model.IsPackage != true)
            {


                if (Model.DiscountValue > 0)
                {


                    <div class="product-invoice-item central px-2 px-lg-4 py-3">
                        @if (Model.ProductTypeId == 2)
                        {
                            <span>هزینه دوره :</span>
                        }
                        else
                        {
                            <span>قیمت :</span>
                        }
                        <span>@firstStoreProductQuantity.BasePrice.ToString("n0")</span>
                        <span>@Resource.Lang.Toman</span>
                    </div>
                    <div class="product-invoice-item central px-2 px-lg-4 py-3">
                        @if (Model.ProductTypeId == 2)
                        {
                            <span>تخفیف این دوره :</span>
                        }
                        else
                        {
                            <span>تخفیف :</span>
                        }

                        <span>@Model.DiscountValue.ToString("n0")</span>
                        <span>@Resource.Lang.Toman</span>
                    </div><div class="product-invoice-item final central px-2 px-lg-4 py-3">
                        <span>مبلغ قابل پرداخت :</span>
                        @if (Model.IsFree)
                        {

                            <span>رایگان</span>
                        }
                        else if (Model.EuroPrice > 0)
                        {
                            <span>@Model.EuroPrice</span>
                            <span>یورو (€)</span>
                        }
                        else
                        {
                            <span>@firstStoreProductQuantity.Price.ToString("n0")</span>
                            <span>@Resource.Lang.Toman</span>
                        }

                    </div>

                }
                else
                {
                    if (Model.IsFree)
                    {
                        <span>رایگان</span>
                    }
                    else if (Model.EuroPrice > 0)
                    {
                        <div class="product-invoice-item final central px-2 px-lg-4 py-3">
                            <span>مبلغ قابل پرداخت :</span>
                            <span>@Model.EuroPrice</span>
                            <span>یورو (€)</span>



                        </div>
                        <div class="product-invoice-item final central px-2 px-lg-4 py-3">

                            <span>@firstStoreProductQuantity.Price.ToString("n0")</span>
                            <span>@Resource.Lang.Toman</span>
                        </div>
                    }

                    else
                    {
                        if (Model.ProductTypeId != 1)
                        {
                            <div class="product-invoice-item final central px-2 px-lg-4 py-3">
                                <span>مبلغ قابل پرداخت :</span>
                                <span>@firstStoreProductQuantity.Price.ToString("n0")</span>
                                <span>@Resource.Lang.Toman</span>
                            </div>
                        }
                    }
                }
            }
            <div class="product-invoice-btn px-2 px-lg-4">
                @if (isAvailable || Model.IsSelectMulti == true)
                {
                    if (Model.HasExpire == false)
                    {
                        if (Model.ProductTypeId == 3)
                        {
                            <div class="pro-counter-box">
                                <a class="btn footer-membership-btn">@Resource.Lang.Count</a>
                                <div class="pro-counter align justify-content-around add-subtract">
                                    <a href="javascript://" class=" increase-count" stock-count="@firstStoreProductQuantity.Count">
                                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M0.186594 6.448V4.192H3.95459V0.52H6.18659V4.192H9.83459V6.448H6.18659V10H3.95459V6.448H0.186594Z" fill="black" />
                                        </svg>
                                    </a>
                                    <span id="add-count" readonly type="number" min="1">1</span>
                                    <a href="javascript://" class="quantity-button decrease-count">
                                        <svg width="10" height="3" viewBox="0 0 10 3" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M0.186594 2.448V0.0959998H9.83459V2.448H0.186594Z" fill="black" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                            <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1})">افزودن به سبد</a>
                        }
                        else if (Model.ProductTypeId == 2)
                        {
                            if (currentUser == null)
                            {
                                <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-bs-toggle="modal" data-bs-target="#exampleModal">ثبت نام در دوره</a>

                            }
                            else
                            {
                                var isValid = true;
                                if (Model.IsParport == true && currentUser.PassportPictureId == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsShenasnameh == true && currentUser.ShenasnamehPictureId == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsCoaching2 == true && currentUser.Coaching2PictureId == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsCoaching3 == true && currentUser.Coaching3PictureId == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsBirthday == true && currentUser.BirthDay == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsPictureId == true && currentUser.PictureID == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsNationalId == true && currentUser.NationalPictureId == null)
                                {
                                    isValid = false;
                                }
                                if (Model.IsQuestion == true && (currentUser.QuestionAnswer == null || currentUser.QuestionAnswer == ""))
                                {
                                    isValid = false;
                                }
                                if (Model.IsEduaction == true && currentUser.EduactionPictureId == null)
                                {
                                    isValid = false;
                                }
                                if ((currentUser.FullName == "" || currentUser.FullName == null) || (currentUser.FullNameEn == "" || currentUser.FullNameEn == null) || (currentUser.NationalCode == "" || currentUser.NationalCode == null))
                                {
                                    isValid = false;
                                }
                                if (Model.QuestionRegisterProduct.Any())
                                {
                                    foreach (var question in Model.QuestionRegisterProduct)
                                    {
                                        if (currentUser.QuestionRegisterValue == null)
                                        {
                                            isValid = false;
                                        }
                                        else if (!currentUser.QuestionRegisterValue.Any(s => s.FieldId == question.FieldId))
                                        {
                                            isValid = false;
                                        }
                                    }
                                }
                                if (isValid == true)
                                {
                                    if (Model.IsPackage == true)
                                    {
                                        if (Model.IsSelectMulti == true)
                                        {
                                            @Html.Action("SearchPartial", "Product", new
                                           {
                                               prId = "",
                                               IsHidden = true,
                                               prstock = true@*hasExpire = false*@,
Isactive = true,
ProductsId = Model.ProductsId + "," + Model.ID,
prpagesize = 12,
prviewname = "PackageTwoItemList",
prorder = DataLayer.Enumarables.Enum_ProductOrder.SHOWNUMBER,
typeId = 2
})
                                        }
                                        else
                                        {

                                            @Html.Action("SearchPartial", "Product", new
                                            {
                                                prId = "",
                                                IsHidden = true,
                                                prstock = true@*hasExpire = false*@,
Isactive = true,
ProductsId = Model.ProductsId + "," + Model.ID,
prpagesize = 12,
prviewname = "PackageOneItemList",
prorder = DataLayer.Enumarables.Enum_ProductOrder.SHOWNUMBER,
typeId = 2
})
                                            if (ViewBag.TestId != true)
                                            {
                                                <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket d-none" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket4" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1 })">ثبت نام در دوره</a>

                                            }
                                            else
                                            {
                                                <p class="alert alert-warning">شما قبلا این پکیج را به سبد اضافه کرده اید در صورت تغییر پکیج را از سبد خرید حذف مجدد اضافه کنید</p>
                                            }

                                        }
                                    }
                                    else
                                    {

                                        <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1 })">ثبت نام در دوره</a>

                                    }

                                }
                                else
                                {
                                    <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-bs-toggle="modal" data-bs-target="#edit_profile_modal2">تکمیل پروفایل</a>

                                }

                            }
                        }
                        else if (Model.ProductTypeId == 1)
                        {
                            <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1,description="سایر"  })">درخواست ارسال گواهی</a>
                        }
                        else
                        {
                            <a id="addtocart-btn" class="btn secondary-btn w-100 add-basket" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1 })">افزودن به سبد</a>

                        }
                    }
                    else
                    {
                        <div class="home-course-unavailable central">
                            <span>اتمام اعتبار</span>
                        </div>
                    }
                }
                else
                {
                    <div class="home-course-unavailable central">
                        <span>ناموجود</span>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">@Resource.Lang.SignIn </h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <svg data-name="Livello 1" id="Livello_1" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="width: 120px;height: 120px;fill: #3A5F9B;border: 4px solid #3A5F9B;border-radius: 50%;padding: 10px;">
                    <defs>
                        <style>
                            .cls-1 {
                                fill: none;
                                stroke: #fff;
                                stroke-linecap: round;
                                stroke-miterlimit: 10;
                                stroke-width: 2px;
                            }
                        </style>
                    </defs>
                    <title />
                    <path d="M0,32A32,32,0,1,0,32,0,32,32,0,0,0,0,32Z" />
                    <g id="User"><path class="cls-1" d="M46,42.18v5.91a0.91,0.91,0,0,1-.9.91H18a0.91,0.91,0,0,1-.9-0.91V42.18c0-4.77,6.47-8.64,14.45-8.64S46,37.41,46,42.18Z" /><ellipse class="cls-1" cx="31.55" cy="21.18" rx="6.42" ry="6.18" /></g>
                </svg>
            </div>
            <div class="modal-footer d-flex flex-column">

                <a href="@Url.Action("Login","Account",new {back=Model.ProductUrl })"
                   class="btn primary_btn w-100">
                    <span>@Resource.Lang.IhaveCode</span>
                </a>
                <a href="@Url.Action("Register","Account",new {back=Model.ProductUrl })" class="btn secondary_btn w-100">@Resource.Lang.IHaveNotRegisteredBefore </a>
            </div>
        </div>
    </div>
</div>
