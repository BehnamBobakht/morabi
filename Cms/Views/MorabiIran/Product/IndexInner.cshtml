﻿@using DataLayer.ViewModels
@using DataLayer.Base;
@using DataLayer.Enumarables
@model DataLayer.ViewModels.ProductShowVm

@{
    bool isAvailable = Model.Code.Label == Enum_Code.PRODUCT_STATUS_AVAILABLE.ToString();
    StoreProductQuantityVm firstStoreProductQuantity = null;
    if (isAvailable && Model.Variety.storeProductQuantities.Any())
    {
        firstStoreProductQuantity = Model.Variety.storeProductQuantities[0];
    }

    ViewAccount currentUser = BaseWebsite.CurrentAccountOnline;
    Model.RateAvarage = Model.RateAvarage == 0 ? 5 : Model.RateAvarage;
}
<div class="col-lg-4 p-0">
    <div class="product-images">
        @Html.Action("IndexPictures", "Product", new { Model = Model, productId = Model.ID })
    </div>
</div>
<div class="col-lg-4 col-sm-7 p-0 ps-sm-3">
    <div class="product-details-box1 d-flex flex-column h-100">
        @if (Model.ProductTypeId == 2)
        {
            <div class="product-name">
                <h1>نام دوره: @Model.Name</h1>
            </div>
        }
        else
        {
            <div class="product-name">
                <h1>@Model.Name</h1>
            </div>
        }
        <div class="product-text">
            <p>@Model.Summary</p>
        </div>
        <div class="product-deadlines">
            @if (Model.ProductTypeId == 2)
            {
                <div class="pro-warning d-flex">
                    <div class="pro-warning-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <mask id="mask0_1746_3320" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                                <rect width="24" height="24" fill="white" />
                            </mask>
                            <g mask="url(#mask0_1746_3320)">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.73441 21.0022C1.96407 21.0022 1.48301 20.1678 1.86898 19.5012L11.1345 3.49701C11.5197 2.83173 12.4802 2.83172 12.8654 3.49701L22.1309 19.5011C22.5169 20.1678 22.0358 21.0022 21.2655 21.0022H2.73441C2.73441 21.0022 1.96407 21.0022 2.73441 21.0022ZM13 18.0001H12.0647C12.0433 18.0015 12.0217 18.0022 12 18.0022C11.9782 18.0022 11.9566 18.0015 11.9352 18.0001H11V16.0001H13V18.0001ZM13 14.0022H11V9.00218H13V14.0022Z" fill="#FF7200" />
                            </g>
                        </svg>
                    </div>
                    <div class="pro-warning-text d-flex flex-column">
                        <span>تاریخ برگزاری حدودی هست و تاریخ دقیق در کانال دوره اعلام میشود</span>
                    </div>
                </div>

                <div class="product-deadline-item">
                    <span>تاریخ شروع ثبت نام</span>
                    <span>
                        @Model.StartDatetime.ToPersianComplete()
                    </span>
                </div>
                <div class="product-deadline-item">
                    <span>تاریخ پایان ثبت نام</span>
                    <span>@Model.EndDatetime.ToPersianComplete()</span>
                </div>

                <div class="product-deadline-item">
                    <span>تاریخ شروع دوره</span>
                    <span>@Model.FromDatetime.ToPersianComplete()</span>
                </div>

                <div class="product-deadline-item">
                    <span>تاریخ پابان دوره</span>
                    <span>@Model.ToDatetime.ToPersianComplete()</span>
                </div>



            }
            @if (Model.ProductTypeId == 1)
            {


                <div>
                    <p>در صورت درخواست گواهی برای دوره های شرکت شده از لیست  دوره ها دوره خود را انتخاب نمایید</p>
                    <p>در غیر این صورت گزینه سایر را انتخاب کنید</p>
                    <div>
                        <div class="form-check">
                            <input class="form-check-input" onchange="showCourse(0)" value="0" type="radio" name="course" id="show-course1">
                            <label class="form-check-label" for="show-course1">
                                سایر
                            </label>
                        </div>
                        <div class="divetext ">
                            <textarea id="desCription" cols="20" rows="5" class="form-control" placeholder="عنوان و یا عناوین دوره های خود را به صورت کامل اینجا بنویسید">
</textarea>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" checked onchange="showCourse(1)" value="1" type="radio" name="course" id="show-course2">
                            <label class="form-check-label" for="show-course2">
                                انتخاب دوره
                            </label>

                        </div>
                        <div class="add-subtract">
                            @if (currentUser != null)
                            {
                                <span class="d-none" id="add-count" readonly type="number" min="0">0</span>

                                <div class="couseList d-none">
                                    @Html.Action("SearchAccountOrder", "Product", new { statusId2 = "2068-2073", typeId = 2, accountId = currentUser.Id, aoViewName = "ListCourse" })
                                    @Html.Action("SearchCourse", "Product", new { aoStatus = DataLayer.Enumarables.Enum_Code.ORDER_STATUS_SUCCESS, typeId = 2, accountId = currentUser.Id, aoViewName = "ListCourseOld" })

                                </div>
                            }
                            else
                            {
                                <a class="btn btn-secondary" href="@Url.Action("Login","Account",new {back=Model.ProductUrl})">ورود به حساب کاربری</a>
                            }

                        </div>
                    </div>
                </div>
            }
            @if (isAvailable)
            {
                if (Model.Variety.Colors.Any())
                {
                    <div class="product-size color">
                        <div class="product-size-title align">
                            <span>@Resource.Lang.Color</span>
                        </div>
                        @foreach (var color in Model.Variety.Colors)
                        {
                            @Ajax.ActionLink(linkText: " ",
            actionName: "IndexInner",
            controllerName: "Product",
            routeValues: new { model = Model, productId = Model.ID, colorId = color.ID },
            htmlAttributes: new { @class = "btn-optionitem m-1 pr-1 pl-1 text-center" + (color.ID == Model.Variety.ColorId ? " selectColor" : ""), @style = "background-color:#" + color.HexValue, @rel = "nofollow" },
            ajaxOptions: new AjaxOptions
            {
            HttpMethod = "GET",
            InsertionMode = InsertionMode.Replace,
            UpdateTargetId = "product-index",
            OnBegin = "beginProssess",
            OnComplete = "endProssess"
            })
                        }
                    </div>
                }
                if (Model.Variety.Sizes.Any())
                {
                    <div class="product-size">
                        <div class="product-size-title align">
                            <span>@Resource.Lang.Size</span>
                        </div>
                        @foreach (var size in Model.Variety.Sizes)
                        {
                            @Ajax.ActionLink(linkText: size.Name,
            actionName: "IndexInner",
            controllerName: "Product",
            routeValues: new { model = Model, productId = Model.ID, colorId = Model.Variety.ColorId, sizeId = size.ID },
            htmlAttributes: new { @class = "btn-optionitem m-1 pr-1 pl-1 text-center" + (size.ID == Model.Variety.SizeId ? " selectColor" : ""), @style = "background-color:#fff", @rel = "nofollow" },
            ajaxOptions: new AjaxOptions
            {
            HttpMethod = "GET",
            InsertionMode = InsertionMode.Replace,
            UpdateTargetId = "product-index",
            OnBegin = "beginProssess",
            OnComplete = "endProssess"
            })
                        }
                    </div>
                }
                if (Model.Variety.OptionItems.Any())
                {
                    <div class="product-size">
                        <div class="product-size-title align">
                            <span>@Model.Variety.OptionName</span>
                        </div>

                        @foreach (var option in Model.Variety.OptionItems)
                        {
                            @Ajax.ActionLink(linkText: option.Value,
            actionName: "IndexInner",
            controllerName: "Product",
            routeValues: new { model = Model, productId = Model.ID, colorId = Model.Variety.ColorId, sizeId = Model.Variety.SizeId, optionItemId = option.ID },
            htmlAttributes: new { @class = "btn-optionitem m-1 pr-1 pl-1 text-center" + (option.ID == Model.Variety.OptionItemId ? " selectColor" : ""), @style = "background-color:#fff", @rel = "nofollow" },
            ajaxOptions: new AjaxOptions
            {
            HttpMethod = "GET",
            InsertionMode = InsertionMode.Replace,
            UpdateTargetId = "product-index",
            OnBegin = "beginProssess",
            OnComplete = "endProssess"
            })
                        }
                    </div>
                }
            }
        </div>
        @if (currentUser != null && Model.Variety.OptionItems.Any())
        {
            @Html.Action("GetPrice", "Product", new { productId = Model.ID })

        }
    </div>
</div>
<div class="col-lg-4 col-sm-5 p-0">
    <div class="product-details-box2">
