                                    <input type="hidden" lang-name="questionItemId" filed-id="@item.QuestionRegister.ID" class="form-control questionText" value="null" />
                                    <input type="hidden" lang-name="questionFileId" class="" id="@("DocumentId"+item.ID)" value="nll" />

                                    <input type="text" lang-name="questionValue" required filed-id="@item.QuestionRegister.ID" class="form-control questionText" />
                                </div>
