@using DataLayer.Base;
@using DataLayer.ViewModels;
@using DataLayer.Enumarables;
@model  ProductSearchVm
@{
   
}
<style>
    .home-course-link.package-item-selected {
        border: 2px solid #198754;
        background-color: #157347;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.16);
    }

    .home-course-link a[data-ajax="true"] {
        display: flex;
        align-items: center;
        width: 100%;
        gap: 10px;
        cursor: pointer;
    }

    .home-course-link input[type="checkbox"][quantityid] {
        width: 21px;
        height: 21px;
        min-width: 21px;
        margin: 0;
        accent-color: #198754;
        pointer-events: none;
    }

    .home-course-link.package-item-selected span {
        color: #fff !important;
    }
</style>
<p class="alert alert-warning">با انتخاب هر دوره آن دوره به سبد خرید شما اضافه میشود و برای مبالغ اقساطی در هر بار یک قسط پرداخت میشود</p>
@foreach (var item in Model.Products2)
{
    bool isAvailable = item.Code.Label == Enum_Code.PRODUCT_STATUS_AVAILABLE.ToString();
    StoreProductQuantityVm firstStoreProductQuantity = null;
    if (isAvailable && item.Variety.storeProductQuantities.Any())
    {
        firstStoreProductQuantity = item.Variety.storeProductQuantities[0];
    }
    <div class=" m-2">
        @if (isAvailable)
        {
        <div class="home-course-link central">
         

            <label for="@("packageMulti"+item.ID)">
                <a id="addtocart-btn" data-ajax="true" data-ajax-begin="startAddToBasket" data-ajax-complete="endAddToBasket" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#cart-badge" sample-href="@(Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID }) + "&count=")" href="@Url.Action("Insert", "Cart", new { quantityId = firstStoreProductQuantity.ID, count = 1 })">
                    <input quantityId="@firstStoreProductQuantity.ID" type="checkbox" id="@("packageMulti"+item.ID)" />
                    <span>@item.Name</span>


                    <span>@firstStoreProductQuantity.Price.GetCurrencyFormat() @Resource.Lang.Toman</span>
                    @if (item.EuroPrice > 0)
                    {
                        <span>(@item.EuroPrice یورو)</span>
                    }
                </a>
                    
            </label>
            

        </div>
        }

    </div>
}
<script>
    (function () {
        if (window.allPackageSelectionInitialized) {
            return;
        }

        window.allPackageSelectionInitialized = true;

        document.addEventListener("click", function (event) {
            if (!event.target || !event.target.closest) {
                return;
            }

            var packageLink = event.target.closest('.home-course-link a[data-ajax="true"]');

            if (!packageLink) {
                return;
            }

            var checkbox = packageLink.querySelector('input[type="checkbox"][quantityid]');

            if (!checkbox) {
                return;
            }

            window.setTimeout(function () {
                checkbox.checked = true;

                var packageItem = packageLink.closest(".home-course-link");

                if (packageItem) {
                    packageItem.classList.add("package-item-selected");
                }

                packageLink.setAttribute("aria-checked", "true");
            }, 0);
        });
    })();
</script>
