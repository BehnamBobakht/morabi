@using DataLayer.ViewModels
@using DataLayer.Base
@model ProductSearchVm
    @{ 
        DateTime now = DateTime.Now;
    }

@foreach (var item in Model.Products.Where(p => (p.StartDatetime == null || (p.StartDatetime != null && p.StartDatetime <= now)) &&
                        (p.EndDatetime == null || (p.EndDatetime != null && p.EndDatetime >= now))))
{
    <div class="swiper-slide">
        @Html.Partial("~/Views/" + BaseWebsite.WebsiteLabel + "/Product/CourseItemInner.cshtml", item)


    </div>

}

