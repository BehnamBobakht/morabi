@model List<DataLayer.Entities.Students>
@using DataLayer.Base;
@using DataLayer.ViewModels;
@using DataLayer.Entities;
@{

    ViewAccount CurrentAccount = BaseWebsite.CurrentAccount;
}

@foreach (var orderProduct in Model)
{

    Product product = orderProduct.Product;
    var exame = product.Exame.FirstOrDefault();
    if (exame != null)
    {
        <tr>
            <th scope="row">@orderProduct.ID</th>
            <td>@product.GetName()</td>
            <td>
                @exame.StartDate.ToPersian()
            </td>
            <td style="direction: ltr;">
                <span> @exame.StartTime.Value.Hours : @exame.StartTime.Value.Minutes</span>
            </td>
            <td>
                <span> @exame.Time دقیقه</span>
            </td>
            @if (exame.IsOpen == true && exame.ExameAccountAnswer.FirstOrDefault(s => s.AccountId == CurrentAccount.Id && s.Finish == true) == null)
            {
                <td class="table-btn"><a class="btn primary-btn" href="@Url.Action("index", "Exame", new { id = exame.ID }, Request.Url.Scheme)">شرکت در آزمون</a></td>
            }
            else if (exame.IsOpen == true && exame.ExameAccountAnswer.FirstOrDefault(s => s.AccountId == CurrentAccount.Id && s.Finish == true) != null)
            {
                <td>در حال بررسی</td>
            }
            else if (exame.ShowUser == true && exame.ExameAccountAnswer.FirstOrDefault(s => s.AccountId == CurrentAccount.Id) != null)
            {
                <td class="table-btn align h-100">
                    <a class="btn primary-btn" href="@Url.Action("Report", "Account", new { exameId = exame.ID }, Request.Url.Scheme)">کارنامه</a>

                </td>
            }
            else
            {
            <td>
            </td>
          
            }
        </tr>
    }



}

