@using DataLayer.Base
@using DataLayer.ViewModels
﻿@model DataLayer.Entities.Product
@{
    ViewAccount CurrentAccount = BaseWebsite.CurrentAccount;
}
@if (Model != null)
{
    <div class="col-sm-4">

        <div class="home-course-item linkitem in-progress">

            <a href="@Model.GetLinkWithUrl()"></a>
            <div class="home-course-img central position-relative">
                @if (Model.Image != "" && Model.Image != null)
                {<img src="@("https://morabiiran.ir/"+Model.Image)" alt="@Model.Name">

                }
                else
                {
                    <img src="@Html.Action("thumburl","picture",new {picurl=Model.Picture.GetUrl(),width=320 })" alt="@Model.Name">

                }
                <div class="home-course-in-progress central">

                    <span>@Model.Name</span>

                </div>


            </div>

        </div>
        <div>

            @if (Model.HasPrint == true)
            {
                <div class="">
                    @if (!Model.PaymentCertificate.Any(s => s.StatusId == 1072 && s.AccountId == CurrentAccount.Id && s.Type == 1))
                    {
                        <a style="background: var(--primary);color: #fff;padding: 3px;margin: 10px 0;" class="btn" href="/PaymentCertificate/Start?type=1&&productId=@Model.ID">دریافت گواهی آنلاین</a>

                    }
                    else
                    {
                        @* <a style="background: var(--primary);color: #fff;padding: 3px;margin: 10px 0;" class="btn" href="/Account/PrintCertificate?ID=@Model.PaymentCertificate.FirstOrDefault(s => s.StatusId == 1072 && s.AccountId == CurrentAccount.Id && s.Type == 1).ID">دانلود گواهی آنلاین</a> *@

                    }
                    @if (!Model.PaymentCertificate.Any(s => s.StatusId == 1072 && s.AccountId == CurrentAccount.Id && s.Type == 2))
                    {
                        <a style="background: var(--primary);color: #fff;padding: 3px;margin: 10px 0;" class="btn" href="/PaymentCertificate/Start?type=2&&productId=@Model.ID">دریافت گواهی فیزیکی</a>

                    }
                    else
                    {
                        <p style="font-size: 14px;margin: 5px 0 10px 0;color: var(--secondary);font-weight: 500;">درخواست گواهی فیزیکی ثبت شد</p>
                    }

                </div>
            }
            <a href="@Model.LinkTelegram">
                <p>کانال تلگرام:</p>
                <p>@Model.LinkTelegram </p>

            </a>

            @*}
                }*@

        </div>
    </div>
}
