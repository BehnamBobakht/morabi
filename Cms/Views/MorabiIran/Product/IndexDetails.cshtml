@using  DataLayer.Base
@model DataLayer.ViewModels.ProductShowVm
@{ 
    if(!string.IsNullOrEmpty(Model.Description))
    {
        Model.Description = Model.Description.Replace("../../../", "/panel/");
        Model.Description = Model.Description.Replace("../../", "/panel/");
    }
}

<section class="product-info ">
    <div class="container">
        <ul class="nav nav-tabs" id="home-products" role="tablist">
            <li class="nav-item">
                <a class="nav-link central active" id="product-description-tab" data-bs-toggle="tab" href="#product-description"
                   role="tab" aria-controls="product-description" aria-selected="true">توضیحات</a>
            </li>
            <li class="nav-item">
                <a class="nav-link central" id="product-specification-tab" data-bs-toggle="tab" href="#product-specification"
                   role="tab" aria-controls="product-specification" aria-selected="false">مشخصات تخصصی</a>
            </li>
            <li class="nav-item">
                <a class="nav-link central" id="product-comments-tab" data-bs-toggle="tab" href="#product-comments"
                   role="tab" aria-controls="product-comments" aria-selected="false">دیدگاه ها</a>
            </li>
           
        </ul>
        <div class="tab-content" id="home-products-content">
            <div class="tab-pane fade show active" id="product-description" role="tabpanel" aria-labelledby="product-description-tab">
                <div class="product-description">
                   @Html.Raw(Model.Description)
                </div>
            </div>
            <div class="tab-pane fade" id="product-specification" role="tabpanel" aria-labelledby="product-specification-tab">
                <div class="specifications">
                    @foreach (var item in Model.ProductCustomValue.Where(s => s.ProductCustomField.Hide == false))
                    {

                        if ((string.IsNullOrEmpty(item.Value) == false || (item.ProductCustomItem != null && string.IsNullOrEmpty(item.ProductCustomItem.Value) == false)))
                        {
                            <div class="specification_one">
                                <div class="specification_title"><span>@item.ProductCustomField.Name:</span></div>
                                @if (item.ItemId == null)
                                {
                                    <div class="specification_text">@item.Value</div>
                                }
                                else
                                {
                                    <div class="specification_text">@item.ProductCustomItem.Value</div>
                                }
                            </div>

                        }

                    }
                </div>
            </div>
            <div class="tab-pane fade" id="product-comments" role="tabpanel" aria-labelledby="product-comments-tab">
                <div class="product_comments">
                    @foreach (var item in Model.ProductComment)
                    {
                        <div class="comment_item">
                            <div class="comment_info">
                                <div class="comment_userImg online_user"><img src="~/Assets/Default/Image/user.png" alt=""></div>
                                <div class="comment_name_date">
                                    <div>
                                        <strong>@item.NameFamily</strong>
                                        @Html.Partial("~/Views/" + BaseWebsite.WebsiteLabel + "/partial/ShowRate.cshtml", item.Rate)
                                    </div>
                                    <span>@item.Datetime.ToPersianWithTime()</span>
                                </div>
                            </div>
                            <div class="comment_text">
                                <p>@item.Body</p>
                            </div>
                            <div class="comment_reply">
                                @if (!string.IsNullOrEmpty(item.AnswerString))
                                {
                                    <div class="reply_item">
                                        <div class="comment_info">
                                            <div class="comment_userImg offline_user"><img src="~/Assets/Default/Image/user.png" alt=""></div>
                                            <div class="comment_name_date">
                                                <a href="#">
                                                    <strong>@Resource.Lang.Boss</strong>
                                                </a><span>@item.AnswerDatetime.ToPersianWithTime()</span>
                                            </div>
                                        </div>
                                        <div class="comment_text">
                                            @item.AnswerString
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <div class="comment_item">
                        <div class="add_comment">
                            <strong>@Resource.Lang.AddComment</strong>
                            <form class="addCm_form text-left">

                                <div id="rate-box" class="rate-box star-rating user-rate">
                                    <input value="5" type="radio" name="rate" id="rate-5">
