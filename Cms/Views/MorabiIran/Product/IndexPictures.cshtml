@model DataLayer.ViewModels.ProductShowVm
<div dir="ltr" class="swiper slider4">
    <div class="swiper-wrapper">
        <div class="swiper-slide">
            <div class="product-image-item linkitem">
                 @if (Model.Picture.Url != "" && Model.Picture.Url  != null)
                {
                    <a data-fancybox="gallery" href="@Model.Picture.Url">
                        <img src="@Model.Picture.Url" />
                    </a>

                }
                else
                {
                    <a data-fancybox="gallery" href="@("https://morabiiran.ir/"+Model.Image)">
                        <img src="@("https://morabiiran.ir/"+Model.Image)" />
                    </a>
                }

            </div>
        </div>
        @for (int i = 0; i < Model.Pictures.Count(); i++)
        {
            <div class="swiper-slide">
                <div class="product-image-item linkitem">
                    <a data-fancybox="gallery" href="@Model.Pictures[i].Url"></a>
                    <img src="@Model.Pictures[i].Url" alt="">
                </div>
            </div>
            
        }
        
    </div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
</div>









