@model List<DataLayer.Entities.Banner>
@using DataLayer.Base
@if (Model.Any())
{
    <div class="modal" tabindex="-1" id="popIndex">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <p class="modal-title">@Model.FirstOrDefault().Name</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.FirstOrDefault().Picture != null)
                    {
                        <img src="@Model.FirstOrDefault().Picture.GetUrl()" alt="@Model.FirstOrDefault().Name">

                    }
                    <a href="@Model.FirstOrDefault().Url">@Model.FirstOrDefault().Summary</a>
                </div>

            </div>
        </div>
    </div>


}
