@model List<DataLayer.Entities.Banner>
@using DataLayer.Base
@if (Model.Any())
{
    <section class="home-about">
        <div class="container">
            <div class="home-about-inner position-relative">
                @if (Model.FirstOrDefault().Picture != null)
                {
                    <img src="@Model.FirstOrDefault().Picture.GetUrl()" alt="@Model.FirstOrDefault().GetName()">

                }
                <div class="col-lg-5 p-0">
                    <div class="home-about-text">
                        <h1>@Model.FirstOrDefault().GetName()</h1>
                        <p>@Model.FirstOrDefault().GetSummery()</p>
                        <a href="@Url.Action("Index","StaticPage",new { id="aboutUs"},Request.Url.Scheme)" class="btn default-btn">@Resource.Lang.More ...</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

}
