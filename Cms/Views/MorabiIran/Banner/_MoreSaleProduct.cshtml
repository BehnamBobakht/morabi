@model List<DataLayer.Entities.Banner>
@using DataLayer.Base
@if (Model.Any())
{
    <div class="buy-products-box">
        <img src="@Html.Action("thumburl","picture",new {picurl=@Model.FirstOrDefault().Picture.GetUrl(),width=320 })" alt="@Model.FirstOrDefault().GetName()">
        <div class="buy-products-content">
            <div class="col-lg-4 col-md-6 p-0">
                <strong>@Model.FirstOrDefault().GetName()</strong>
                <p>@Model.FirstOrDefault().GetSummery()</p>
                <a href="@Model.FirstOrDefault().Url">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <mask id="mask0_634_410" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                            <rect width="24" height="24" fill="white" />
                        </mask>
                        <g mask="url(#mask0_634_410)">
                            <path d="M17.5 18.5L24 12L17.5 5.49998L16.7929 6.20708L22.0858 11.5L6.1196e-07 11.5L5.24537e-07 12.5L22.0857 12.5L16.7929 17.7929L17.5 18.5Z" fill="#3CC80B" />
                        </g>
                    </svg>
                    @Resource.Lang.SeeProduct
                </a>
            </div>
        </div>
    </div>
    
}
