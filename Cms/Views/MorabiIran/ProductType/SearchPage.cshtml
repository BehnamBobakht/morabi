@model DataLayer.ViewModels.ProductSearchVm


<div class="filtering_item box">
    <strong class="filtering_title align justify-content-between">
        @Resource.Lang.ProductCategory
        <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.9425 7.11937L6.75826 7.82637L13.2856 2.16937L11.654 0.755371L6.75826 4.99737L1.8625 0.755371L0.230957 2.16937L5.9425 7.11937Z" fill="black" />
        </svg>
    </strong>
    <div class="open-close-box">
        @if (Model.ProductTypes.Any())
        {

            foreach (var pType in Model.ProductTypes.Where(s => s.Active && s.Deleted != true))
            {
                bool pTypeExpand = false;
                if (pType.ID == Model.ProductTypeId)
                {
                    pTypeExpand = true;
                }
                <div class="product_filter_item filter_dropdown">
                    <div class="products_filter_slide  @(pTypeExpand?"categoryExoand":"") ">
                        <div class="filter_item_icon">
                            <div class="fIcon_line fI_line1"></div>
                            <div class="fIcon_line fI_line2"></div>
                        </div>
                        <a href="@pType.Href">@pType.Name </a>
                    </div>
                    <div class="panel_slide">
                        <div class="filter_slide_body @(pTypeExpand?"show_filter_item":"")">
                            <ul>
                                @foreach (var pCat in pType.ProductCategory.Where(s => s.Active && s.Deleted != true))
                                {
                                    bool pCatExpand = false;
                                    if (pCat.ID == Model.ProductCategoryId)
                                    {
                                        pCatExpand = true;
                                    }
                                    <li class="subCat_line filter_dropdown @(pCatExpand?"categoryExoand":"")">
                                        <div class="subCat_filter_slide ">
                                            <div class="filter_item_icon">
                                                <div class="fIcon_line fI_line1"></div>
                                                <div class="fIcon_line fI_line2"></div>
                                            </div>
                                            <a href="@pCat.Href">
                                                @pCat.Name
                                            </a>
                                        </div>
                                        <div class="panel_slide">
                                            <div class="subCat_slide_body ">
                                                <ul>
                                                    @foreach (var pSub in pCat.ProductSubCategory.Where(s => s.Active && s.Deleted != true))
                                                    {
                                                        <li class="brand_filter">
                                                            <a href="@pSub.Href">
                                                                @if (pSub.ID == Model.ProductSubCategoryId)
                                                                {
                                                                    <strong>@pSub.Name</strong>
                                                                }
                                                                else
                                                                {
                                                                    <span>@pSub.Name</span>

                                                                }
                                                            </a>
                                                        </li>
                                                    }

                                                </ul>
                                            </div>
                                        </div>
                                    </li>
                                }


                            </ul>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>


