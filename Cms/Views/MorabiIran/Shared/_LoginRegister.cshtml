@using DataLayer.ViewModels;
@using DataLayer.Base;
@{ViewAccount currentUser = BaseWebsite.CurrentAccount; }

@Html.Partial("~/Views/" + BaseWebsite.WebsiteLabel + "/Shared/_Cart.cshtml")
@if (currentUser == null)
{
    <a href="@Url.Action("Login","Account")" class="btn login-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21.08 8.58003V15.42C21.08 16.54 20.48 17.58 19.51 18.15L13.57 21.58C12.6 22.14 11.4 22.14 10.42 21.58L4.48003 18.15C3.51003 17.59 2.91003 16.55 2.91003 15.42V8.58003C2.91003 7.46003 3.51003 6.41999 4.48003 5.84999L10.42 2.42C11.39 1.86 12.59 1.86 13.57 2.42L19.51 5.84999C20.48 6.41999 21.08 7.45003 21.08 8.58003Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M12 11.0001C13.2869 11.0001 14.33 9.95687 14.33 8.67004C14.33 7.38322 13.2869 6.34009 12 6.34009C10.7132 6.34009 9.67004 7.38322 9.67004 8.67004C9.67004 9.95687 10.7132 11.0001 12 11.0001Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M16 16.6601C16 14.8601 14.21 13.4001 12 13.4001C9.79 13.4001 8 14.8601 8 16.6601" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="header-btn-text">@Resource.Lang.SignIn</span>
    </a>
    <a href="@Url.Action("Register","Account")" class="btn login-btn">
        <span class="header-btn-text">@Resource.Lang.SignUp</span>
    </a>

}
<!-- دکمه پروفایل پس از لاگین -->
@if (currentUser != null)
{
    <!-- دکمه پروفایل پس از لاگین -->
    <div class="btn-group userProfile">
        <a href="javascript://" class="btn userProfile_icon" id="defaultDropdown"
           data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
                <path d="M10.49 2.23006L5.50003 4.10005C4.35003 4.53005 3.41003 5.89004 3.41003 7.12004V14.55C3.41003 15.73 4.19005 17.28 5.14005 17.99L9.44003 21.2001C10.85 22.2601 13.17 22.2601 14.58 21.2001L18.88 17.99C19.83 17.28 20.61 15.73 20.61 14.55V7.12004C20.61 5.89004 19.67 4.53005 18.52 4.10005L13.53 2.23006C12.68 1.92006 11.32 1.92006 10.49 2.23006Z"
                      stroke="#fff" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M12.0001 10.92C11.9601 10.92 11.9101 10.92 11.8701 10.92C10.9301 10.89 10.1801 10.11 10.1801 9.16003C10.1801 8.19003 10.9701 7.40002 11.9401 7.40002C12.9101 7.40002 13.7001 8.19003 13.7001 9.16003C13.6901 10.12 12.9401 10.89 12.0001 10.92Z"
                      stroke="#fff" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M10.01 13.7201C9.05004 14.3601 9.05004 15.4101 10.01 16.0501C11.1 16.7801 12.89 16.7801 13.98 16.0501C14.94 15.4101 14.94 14.3601 13.98 13.7201C12.9 12.9901 11.11 12.9901 10.01 13.7201Z"
                      stroke="#fff" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
            <svg width="13" height="13" viewBox="0 0 18 18" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="#fff" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>@Resource.Lang.Profile</span>
        </a>
        <ul class="profile_items dropdown-menu">
            <li>
                <a href="@Url.Action("Profile","Account")" class="prfile_item_name">
                    <strong>@currentUser.FullName @currentUser.LatName</strong>
                    <span>
                        @Resource.Lang.ViewProfile <i class="bi bi-chevron-left"
                                                      aria-hidden="true"></i>
                    </span>
                </a>
            </li>
            @if (currentUser.StoreId > 0)
            {
                <li>
                    <a class="dropdown-item" href="/store/dashboard">
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span class="mr-1">@Resource.Lang.StorePanel</span>
                    </a>
                </li>
            }
            <li>
                <a href="/Account/SearchAccountOrder?aoViewName=Order&aoStatus=ORDER_STATUS_INSERTED"> <i class="bi bi-cart4" aria-hidden="true"></i>@Resource.Lang.Orders</a>
            </li>
            <li><a href="@Url.Action("Logout","Account")"> <i class='bi bi-door-closed'></i> @Resource.Lang.SignOut </a></li>


        </ul>

    </div>
}


