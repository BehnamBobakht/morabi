</div>
<div class="morabi-cursor-dot" aria-hidden="true"></div>
<div class="morabi-cursor-ring" aria-hidden="true"></div>
<script>
    (function () {
        var dockMenuButton = document.querySelector('.mr-dock-menu');
        var dockMenuPanel = document.getElementById('morabi-dock-menu-panel');
        var dockMenuClose = document.querySelector('.morabi-dock-menu-close');
        function setDockMenu(open) {
            if (!dockMenuPanel) return;
            dockMenuPanel.classList.toggle('open', open);
            dockMenuPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
        }
        if (dockMenuButton) dockMenuButton.addEventListener('click', function (event) { event.preventDefault(); event.stopPropagation(); setDockMenu(!dockMenuPanel.classList.contains('open')); });
        if (dockMenuClose) dockMenuClose.addEventListener('click', function () { setDockMenu(false); });
        document.addEventListener('click', function (event) { if (dockMenuPanel && dockMenuPanel.classList.contains('open') && !dockMenuPanel.contains(event.target) && event.target !== dockMenuButton) setDockMenu(false); });

        var mobileChat = document.querySelector('.floating-chat');
        if (mobileChat) mobileChat.addEventListener('click', function (event) {
            if (!window.matchMedia('(max-width: 760px)').matches || mobileChat.classList.contains('is-open')) return;
            event.preventDefault();
            mobileChat.classList.add('is-open');
            window.setTimeout(function () { mobileChat.classList.remove('is-open'); }, 3500);
        });

        if (!window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;

        var dot = document.querySelector('.morabi-cursor-dot');
        var ring = document.querySelector('.morabi-cursor-ring');
        var x = -100, y = -100, ringX = -100, ringY = -100, size = 34;
        var frame = 0;

        function renderCursor() {
            ringX += (x - ringX) * .17;
            ringY += (y - ringY) * .17;
            dot.style.transform = 'translate3d(' + (x - 3.5) + 'px,' + (y - 3.5) + 'px,0)';
            ring.style.transform = 'translate3d(' + (ringX - size / 2) + 'px,' + (ringY - size / 2) + 'px,0)';
            frame = Math.abs(x - ringX) + Math.abs(y - ringY) > .1
                ? requestAnimationFrame(renderCursor)
                : 0;
        }

        document.addEventListener('pointermove', function (event) {
            if (event.pointerType !== 'mouse') return;
            x = event.clientX;
            y = event.clientY;
            dot.classList.add('visible');
            ring.classList.add('visible');
            if (!frame) frame = requestAnimationFrame(renderCursor);
        }, { passive: true });

        document.addEventListener('pointerover', function (event) {
            var active = event.target instanceof Element && event.target.closest('a,button,input,.tilt');
            ring.classList.toggle('action', !!active);
            size = active ? 54 : 34;
            if (!frame) frame = requestAnimationFrame(renderCursor);
        });

        document.documentElement.addEventListener('pointerleave', function () {
            dot.classList.remove('visible');
            ring.classList.remove('visible');
        });
    })();
</script>
